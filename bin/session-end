#!/bin/bash
# bin/session-end [folder] [--since <epoch>]: SessionEnd hook (no model), also run by hand or by a launcher. Journals
# the commits made during the session, then commits that folder's hub files and the journal to the hub (only those
# paths) under the sync lock, releases it, then runs `bin/brain index` and then `bin/sync --auto`, which pushes (off:
# HUB_AUTO_SYNC=0 in hub.conf or AGENT_AUTO_SYNC=0; AGENT_SYNC_CMD replaces the command, for tests). On the hook path
# (no --since) those two steps run detached, in their own session with no pipe of the hook's, and the hook returns
# without waiting on them; with --since they run in the foreground. A failed step logs `bg step failed: <step> exit <n>`.
# Reads the hook JSON on stdin for at most 2 s (a stdin that never closes, or a terminal, is not waited on).
# Session start = --since, else the first transcript line's timestamp, else the last 8 hours.
# The sync lock is waited on for at least AGENT_HOOK_LOCK_WAIT seconds (default 5) on the hook path, AGENT_LOCK_WAIT
# (default 30) with --since; still busy: nothing is committed and one journal line says the hub commit was skipped
# (written even with no repo commits, when hub files are pending).
# With --since (9-11 digits), one line per run goes to $AGENT_SESSION_END_LOG (default $(state_dir)/logs/session-end.log).
# Otherwise writes nothing to the journal when no repo has commits since the start. Exit 0; 2 = bad usage.
. "$(dirname "$0")/lib.sh"; H="$(hub_root)"; F=""; SINCE=""; SINCE_OK=""; SINCE_GIVEN=0
LOG="${AGENT_SESSION_END_LOG:-$(state_dir)/logs/session-end.log}"
log() { mkdir -p "$(dirname "$LOG")" 2>/dev/null; echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') $(printf '%s' "$*" | tr '\n\r' '  ')" >> "$LOG" 2>/dev/null; }
# the log names the start only once it is a valid epoch; a raw --since value never reaches it
outcome() { [ "$SINCE_GIVEN" = 1 ] && log "${F:-.} since=${SINCE_OK:-?} $*"; return 0; }
refuse() { echo "session-end: $1${2:+, got '$2'}" >&2; outcome "refused: $1"; exit 2; }
refresh_brain() { [ -x "$H/bin/brain" ] || return 0; timeout 120 "$H/bin/brain" index >/dev/null 2>&1; }
# then push the hub: bin/sync --auto
auto_sync() {
  [ "${AGENT_AUTO_SYNC:-${HUB_AUTO_SYNC:-1}}" = 0 ] && return 0
  if [ -n "${AGENT_SYNC_CMD:-}" ]; then (cd "$H" && $AGENT_SYNC_CMD) >/dev/null 2>&1 < /dev/null
  else (cd "$H" && "$H/bin/sync" --auto) >/dev/null 2>&1 < /dev/null; fi
}
# the steps after the commit, in order; a failure is one log line (step name and status only, never its output)
after_steps() {
  local rc
  refresh_brain; rc=$?; [ "$rc" = 0 ] || log "bg step failed: brain index exit $rc"
  auto_sync; rc=$?; [ "$rc" = 0 ] || log "bg step failed: sync exit $rc"
  return 0
}
# the detached job re-enters this script (internal, never an option): only the steps, no journal line
if [ "${AGENT_SESSION_END_BG:-}" = 1 ]; then unset AGENT_SESSION_END_BG; after_steps; exit 0; fi
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
while [ $# -gt 0 ]; do
  case "$1" in
    --since) SINCE_GIVEN=1; [ $# -ge 2 ] || refuse "--since needs an epoch"; SINCE="$2"; shift 2 ;;
    -*) refuse "unknown argument: $1" ;;
    *) [ -z "$F" ] || refuse "unknown argument: $1"; F="$1"; shift ;;
  esac
done
F="${F:-.}"
if [ "$SINCE_GIVEN" = 1 ]; then
  case "$SINCE" in ""|*[!0-9]*) refuse "--since must be an epoch (9-11 digits)" "$SINCE" ;; esac
  [ ${#SINCE} -ge 9 ] && [ ${#SINCE} -le 11 ] || refuse "--since must be an epoch (9-11 digits)" "$SINCE"
  SINCE_OK="$SINCE"
fi
# stdin with a deadline (as bin/changes): a pipe that never closes must not hang the session end
in=$(python3 -c '
import json, os, select, sys, time
raw = b""
if not os.isatty(0):
    end = time.time() + 2
    while time.time() < end and len(raw) < 1 << 20:
        r, _, _ = select.select([0], [], [], max(0, end - time.time()))
        if not r: break
        b = os.read(0, min(65536, (1 << 20) - len(raw)))
        if not b: break
        raw += b
        try: json.loads(raw); break
        except ValueError: pass
sys.stdout.write(raw.decode("utf-8", "replace"))
' 2>/dev/null); now=$(date +%s)
tp=$(printf '%s' "$in" | sed -n 's/.*"transcript_path"[ ]*:[ ]*"\([^"]*\)".*/\1/p')
start=""
if [ -n "$tp" ] && [ -f "$tp" ]; then
  ts=$(head -1 "$tp" | sed -n 's/.*"timestamp"[ ]*:[ ]*"\([0-9T:-]*\).*/\1/p')
  [ -n "$ts" ] && start=$(utc_epoch "$ts")
fi
[ "$SINCE_GIVEN" = 1 ] && start="$SINCE"
[ -n "$start" ] || start=$((now - 8*3600))
commits=""; pushed=""
while IFS= read -r r; do
  [ -n "$r" ] || continue
  c=$(git -C "$r" log --since="@$start" --oneline -10 2>/dev/null | tr '\n' '|' | sed 's/|$//; s/|/, /g')
  [ -n "$c" ] || continue
  commits="$commits${commits:+; }$(basename "$r"): $c"
  p=$(git -C "$r" for-each-ref --format='%(committerdate:unix) %(refname:short)' refs/remotes 2>/dev/null |
    awk -v s="$start" '$1>=s && $2!~/\/HEAD$/{print $2}' | tr '\n' ' ')
  [ -n "$p" ] && pushed="$pushed${pushed:+; }$(basename "$r"): ${p% }"
done <<EOR
$(repos_of "$F")
EOR
commit_folder() {
  RESULT="nothing to commit"
  [ "$F" = . ] && return 0
  cd "$H" || return 0
  [ -n "$(git status --porcelain -- "$F" journal 2>/dev/null)" ] || return 0
  git add -- "$F" journal 2>/dev/null
  local fs=(); while IFS= read -r x; do fs+=("$x"); done < <(git diff --cached --name-only -- "$F" journal)
  [ ${#fs[@]} -gt 0 ] || return 0
  if git commit -q -m "session $F $(date -u '+%Y-%m-%d %H:%M')" -- "${fs[@]}" >/dev/null 2>&1; then RESULT=committed
  else RESULT="failed: commit refused"; fi
  return 0
}
pending() { [ "$F" != . ] && [ -n "$(cd "$H" && git status --porcelain -- "$F" journal 2>/dev/null)" ]; }
# start_detached: run the steps in a new session (python3 forks, then os.setsid), stdin /dev/null, stdout and stderr
# to the session-end log, not waited on. Claude Code waits on the hook's pipes, so no child may keep them open.
# Without python3 it falls back to nohup (same session and process group, but the same redirects).
start_detached() {
  local out="$LOG"; mkdir -p "$(dirname "$LOG")" 2>/dev/null; { : >> "$LOG"; } 2>/dev/null || out=/dev/null
  if command -v python3 >/dev/null 2>&1; then
    AGENT_SESSION_END_BG=1 python3 -c 'import os, sys
if os.fork(): os._exit(0)
os.setsid(); os.execv(sys.argv[1], sys.argv[1:])' "$SELF" "$F" < /dev/null >> "$out" 2>&1 &
  else
    AGENT_SESSION_END_BG=1 nohup "$SELF" "$F" < /dev/null >> "$out" 2>&1 &
  fi
}
line=""
if [ -n "$commits" ]; then
  files=$(find "$H/$F" -type f -not -path '*/.git/*' -mmin "-$(( (now - start) / 60 + 1 ))" 2>/dev/null | sed "s#^$H/$F/##" | head -10 | tr '\n' ',' | sed 's/,$//; s/,/, /g')
  line="auto: session ended; commits: $commits${pushed:+; branches pushed: $pushed}; changed files in folder: ${files:-none}"
fi
# the journal line and the commit run under the sync lock, released before the follow-on sync needs it
LOCK="$(sync_lock_path)"; W="$(sync_hook_lock_wait)"; [ "$SINCE_GIVEN" = 1 ] && W="$(sync_lock_wait)"
if sync_lock_take "$LOCK" "$W" log; then
  trap 'sync_lock_release "$LOCK"' EXIT
  [ -n "$line" ] && "$(dirname "$0")/journal" "$F" "$line"
  commit_folder
  sync_lock_release "$LOCK"; trap - EXIT
else
  RESULT="skipped: sync lock busy"
  if [ -n "$line" ] || pending; then
    "$(dirname "$0")/journal" "$F" "${line:-auto: session ended; commits: none}; hub commit skipped: sync lock busy"
  fi
fi
outcome "$RESULT"
# an `ended` event for the hub's event log (story C6); never for the hub root, never fails the session end
[ "$F" = . ] || H="$H" ST="$(state_dir)" python3 -I "$(dirname "$0")/events.py" write --auto --from "$F" --to main \
  --kind ended --text "ended: commits: ${commits:-none}; hub: $RESULT" >/dev/null 2>&1
# --since (the launcher's and a manual run): the steps in the foreground; the hook path: detached, not waited on
if [ "$SINCE_GIVEN" = 1 ]; then after_steps; else start_detached; fi
exit 0
