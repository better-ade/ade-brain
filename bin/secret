#!/bin/bash
# bin/secret <name>: a secret from this hub's store (service: HUB_KEYCHAIN_SERVICE, default the hub name), on stdout for
# $(...) use only. The store (bin/lib.sh, story V1): the macOS Keychain; on Linux `pass` when installed and initialised,
# else the file store under ~/.config/ade/secrets/<service>/ (0700 folders, 0600 files; refused when looser).
#   --set <name>   store or replace it (reads the value from a hidden prompt; never from an argument)
#   --has <name>   exit 0 when stored, 1 when not (prints nothing)
#   --forget <name>, --list (names only)
# Never echo the value, write it to a file (other than the file store), or put it in a commit, log, URL or chat.
set -u; . "$(dirname "$0")/lib.sh"
USAGE="usage: bin/secret <name> | --set <name> | --has <name> | --forget <name> | --list"
store() { local why; why="$(secret_store_refusal)"; [ -z "$why" ] || { echo "secret: $why" >&2; exit 1; }; }
named() { [ -n "${1:-}" ] || exit 2; [ "$(secret_store)" = keychain ] || secret_name_ok "$1" || { echo "secret: a name is letters, digits, . _ and - only" >&2; exit 2; }; }
case "${1:-}" in
  --set) named "${2:-}"; store; printf 'value for %s: ' "$2" >&2; read -rs v; echo >&2
    [ -n "$v" ] || { echo "empty; nothing stored" >&2; exit 1; }
    secret_put "$2" "$v" || { unset v; echo "could not store $2 in $(secret_store_label)" >&2; exit 1; }
    unset v; echo "stored $2" >&2 ;;
  --has) named "${2:-}"; store; secret_has "$2" ;;
  --forget) named "${2:-}"; store; secret_forget "$2" && echo "forgot $2" >&2 ;;
  --list) store; secret_names ;;
  ""|-*) echo "$USAGE" >&2; exit 2 ;;
  *) named "$1"; store; secret_get "$1" || { echo "secret: $1 not stored (bin/secret --set $1)" >&2; exit 1; } ;;
esac
