#!/bin/bash
# bin/dispatch [--approve <ref>] <folder>: starts a focus builder (bin/work --role builder --name <ref> --prompt "bmad-build <ref>")
# for each ready_to_start ticket in the folder checkout's BMAD `tickets next`, up to the free slots (story C3).
# Slots (hub-wide): HUB_DISPATCH_MAX (hub.conf or the environment; unset = 1, above 2 = 2), less the running builder
# sessions of every folder (bin/sessions), the running ticket sessions of other roles and the starts of the last 120 s whose
# session is not listed yet ($(state_dir)/dispatch/<name> markers). A ticket runs when a session or a recent marker has its
# name and this folder; it is not started again. One run at a time: $(state_dir)/dispatch.lock (a held lock refuses).
# A ticket is started only when its risk is low or medium and it has no hitl (nor a hitl drift); the risk is the higher of
# the leaf file's and its tickets.toml entry's (`tickets find`; a disagreement counts as the higher, one that cannot be
# checked waits). A high-risk, hitl or unknown-risk ticket is printed as "waiting for the owner" and journaled;
# `--approve <ref>` starts that one ticket when it is ready, not running and a slot is free, and only at an interactive
# terminal where the owner types the ref back. Ready-to-refine, in-progress and blocked tickets are never started.
# Refuses (starts nothing) on any doubt: the folder must have exactly one Code repo whose checkout exists and holds
# _bmad/ade-runtime.mjs; `tickets next` failing or printing something unreadable, or bin/sessions failing, exits 1.
# A ref must start with a letter or digit and hold A-Za-z0-9._/- only (else it is skipped); --name gets the ref with every
# other character turned into -. Each run that gets as far as the ticket list writes one journal line (bin/journal) with what
# started and what waits, unless nothing started and the line equals the folder's last dispatch line today.
# Exit: 0 done (also when nothing was ready), 1 refused or a bin/work start failed, 2 usage.
# bin/dispatch --list [folder] (story H1, .ade/context/hub-interface.md): read-only. One `<ready|waiting|running><TAB><ref>
# <TAB><folder>` line per ticket of the folder, or of every folder with one BMAD checkout (others are skipped): ready =
# would start when a slot is free, waiting = needs the owner (--approve), running = its session or a recent start marker
# runs (a ready_to_start or in_progress ticket). No lock, no start, no marker removed, no journal line. Exit 0 listed;
# 1 a named folder has no BMAD checkout, or tickets next or bin/sessions failed; 2 usage. (--list-one is internal.)
set -u; . "$(dirname "$0")/lib.sh"; H="$(hub_root)"; B="$(cd "$(dirname "$0")" && pwd)"
USAGE="usage: bin/dispatch [--approve <ref>] <folder> | bin/dispatch --list [folder]"
APPROVE=""; LIST=0
case "${1:-}" in
  --list) [ $# -le 2 ] || { echo "$USAGE" >&2; exit 2; }
    if [ $# -eq 2 ]; then folders | grep -qxF -- "${2%/}" || { echo "dispatch: no folder '$2' (projects/<name> or ops/<name>)" >&2; exit 2; }
      "$B/dispatch" --list-one "${2%/}"; s=$?; [ "$s" != 3 ] || s=1; exit "$s"; fi
    # every folder: one without a BMAD checkout (exit 3) is skipped quietly; any other failure is shown and exits 1
    rc=0; E="$(mktemp)"; trap 'rm -f "$E"' EXIT
    for f in $(folders); do "$B/dispatch" --list-one "$f" 2>"$E"; s=$?; case "$s" in 0|3) ;; *) cat "$E" >&2; rc=1 ;; esac; done
    exit "$rc" ;;
  --list-one) [ $# -eq 2 ] || { echo "$USAGE" >&2; exit 2; }; LIST=1; shift ;;
esac
# a folder that cannot be dispatched: refused (1), or skipped by a listing (3)
XS=1; [ "$LIST" = 0 ] || XS=3
if [ "${1:-}" = --approve ]; then [ $# -ge 2 ] && [ -n "$2" ] || { echo "$USAGE" >&2; exit 2; }; APPROVE="$2"; shift 2; fi
[ $# -eq 1 ] || { echo "$USAGE" >&2; exit 2; }
F="${1%/}"
folders | grep -qxF -- "$F" || { echo "dispatch: no folder '$F' (projects/<name> or ops/<name>)" >&2; exit 2; }
MAX="${HUB_DISPATCH_MAX:-1}"
[ "$LIST" = 1 ] || [[ "$MAX" =~ ^[0-9]+$ ]] || { echo "dispatch: HUB_DISPATCH_MAX must be a whole number (got '$MAX')" >&2; exit 2; }
[[ "$MAX" =~ ^[0-9]+$ ]] && [ "$MAX" -le 2 ] || MAX=2
SD="$(state_dir)"; LK="$SD/dispatch.lock"; MK="$SD/dispatch"; MINE=0
T="$(mktemp)"; trap 'rm -f "$T"; [ "$MINE" = 0 ] || rm -rf "$LK"' EXIT
if [ "$LIST" = 0 ]; then
mkdir -p "$MK" || { echo "dispatch: cannot write $MK; nothing started" >&2; exit 1; }
# one run at a time; a lock whose pid no longer runs is taken over, any other (or one without a pid yet) refuses
if ! mkdir "$LK" 2>/dev/null; then
  p="$(cat "$LK/pid" 2>/dev/null)"
  if [[ "$p" =~ ^[0-9]+$ ]] && ! ps -p "$p" >/dev/null 2>&1; then rm -rf "$LK"; mkdir "$LK" 2>/dev/null; else false; fi ||
    { echo "dispatch: another dispatch run holds $LK (pid ${p:-unknown}); nothing started (remove it if no dispatch runs)" >&2; exit 1; }
fi
MINE=1; echo $$ > "$LK/pid"
fi

# the checkout: exactly one Code repo (the one bin/work opens by default) with an existing checkout
A="$H/$F/ACCESS.md"
nrows=$(awk -F'|' '/^## /{c=($0=="## Code")} /^\|/{n=$2; k=$3; gsub(/^[ \t]+|[ \t]+$/,"",n); gsub(/^[ \t]+|[ \t]+$/,"",k);
  if((c || k ~ /^[\/~]/) && n!="" && n!="Repo" && n !~ /^-+$/ && n !~ /^\(/) print n}' "$A" 2>/dev/null | grep -c .)
CK="$(repos_of "$F")"
[ "$nrows" -eq 1 ] && [ -n "$CK" ] && [ "$(printf '%s\n' "$CK" | grep -c .)" -eq 1 ] ||
  { echo "dispatch: $F needs exactly one Code repo with an existing checkout in ACCESS.md (repos: $nrows); nothing started" >&2; exit "$XS"; }
RT="$CK/_bmad/ade-runtime.mjs"
[ -f "$RT" ] || { echo "dispatch: no BMAD in $CK ($RT missing); nothing started" >&2; exit "$XS"; }
command -v node >/dev/null 2>&1 || { echo "dispatch: node not found; nothing started" >&2; exit 1; }

if ! J=$(node "$RT" tickets --project-root "$CK" next 2>"$T"); then
  { echo "dispatch: tickets next failed; nothing started"; [ -z "$J" ] || echo "$J"; cat "$T"; } >&2; exit 1
fi
# one line per ticket: R<TAB>ref<TAB>risk<TAB>hitl(0|1)<TAB>id<TAB>file(0|1) for ready_to_start, O<TAB>ref<TAB>group for the rest,
# B<TAB>json-quoted ref for a ready ref with other characters
rows=$(printf '%s' "$J" | python3 -c '
import json, re, sys
d = json.load(sys.stdin)
assert isinstance(d, dict) and isinstance(d.get("ready_to_start"), list)
ok = re.compile(r"[A-Za-z0-9][A-Za-z0-9._/-]*")
def on(v): return v not in (None, False, "", "false", 0)
for g in ("ready_to_start", "ready_to_refine", "in_progress", "blocked"):
    rs = d.get(g, [])
    assert isinstance(rs, list)
    for r in rs:
        assert isinstance(r, dict)
        ref = r.get("ref")
        if not isinstance(ref, str) or not ok.fullmatch(ref):
            if g == "ready_to_start": print("B\t" + json.dumps(ref))
            continue
        if g != "ready_to_start": print("O\t%s\t%s" % (ref, g)); continue
        risk = r.get("risk") if isinstance(r.get("risk"), str) else ""
        drift = r.get("drift") if isinstance(r.get("drift"), dict) else {}
        hitl = on(r.get("hitl")) or "hitl" in drift
        i = r.get("id"); i = str(i) if isinstance(i, int) and not isinstance(i, bool) else "-"
        f = 1 if isinstance(r.get("file"), str) and r.get("file") else 0
        print("R\t%s\t%s\t%d\t%s\t%d" % (ref, re.sub(r"[^A-Za-z0-9_-]", "?", risk) or "-", 1 if hitl else 0, i, f))
' 2>/dev/null) || { echo "dispatch: tickets next printed something unreadable; nothing started" >&2; exit 1; }

SESS=$("$B/sessions" </dev/null 2>"$T") || { echo "dispatch: bin/sessions failed; nothing started" >&2; cat "$T" >&2; exit 1; }
# running = "<name> <folder>" of every listed session, plus the start markers of the last 120 s
LISTED=$(printf '%s\n' "$SESS" | awk 'NR>1 && $1!="" {print $1, $2}')
now=$(date +%s); RECENT=""
for m in "$MK"/*; do
  [ -f "$m" ] || continue; read -r at mf < "$m" || true
  if [[ "${at:-}" =~ ^[0-9]+$ ]] && [ $((now - at)) -lt 120 ] && [ -n "${mf:-}" ]; then RECENT="$RECENT${m##*/} $mf"$'\n'; elif [ "$LIST" = 0 ]; then rm -f "$m"; fi
done
runs() { printf '%s\n%s\n' "$LISTED" "$RECENT" | grep -qxF -- "$1 $F"; }
used=$(printf '%s\n' "$SESS" | awk 'NR>1 && $6=="builder"' | grep -c .)
# a recent start whose session is not listed yet takes a slot (hub-wide)
while read -r mn mf; do
  [ -n "$mn" ] || continue; printf '%s\n' "$LISTED" | grep -qxF -- "$mn $mf" || used=$((used + 1))
done <<< "$RECENT"
name_of() { printf '%s' "$1" | sed 's/[^A-Za-z0-9._-]/-/g'; }
# a running ticket session of this folder that is not a builder still takes a slot
while IFS="$(printf '\t')" read -r k ref _; do
  [ "$k" = R ] || continue; n="$(name_of "$ref")"
  if printf '%s\n' "$SESS" | awk -v n="$n" -v f="$F" 'NR>1 && $1==n && $2==f && $6!="builder" {x=1} END{exit !x}'; then used=$((used + 1)); fi
done <<< "$rows"
free=$((MAX - used)); [ "$free" -ge 0 ] || free=0

start() {  # start <ref>: one bin/work builder for the ticket, then its start marker
  "$B/work" --role builder --name "$(name_of "$1")" --prompt "bmad-build $1" "$F" </dev/null || return 1
  echo "$(date +%s) $F" > "$MK/$(name_of "$1")"
}
# risk_of <ref> <file risk> <id>: the higher of the leaf file's risk and its tickets.toml entry's, "unverifiable" when
# `tickets find` or the entry cannot be read
risk_of() {
  local fj; fj=$(node "$RT" tickets --project-root "$CK" find "$1" 2>/dev/null) || { echo unverifiable; return; }
  printf '%s' "$fj" | python3 -c '
import json, os, sys
rank = {"low": 1, "medium": 2, "high": 3}
fr, i = sys.argv[1], sys.argv[2]
try:
    import tomllib
    sf = json.load(sys.stdin).get("story_file")
    assert isinstance(sf, str) and sf
    p = os.path.join(os.path.dirname(sf), "tickets.toml")
    entries = tomllib.load(open(p, "rb")).get("entry", []) if os.path.isfile(p) else []
except Exception:
    print("unverifiable"); sys.exit(0)
er = None
for e in entries:
    if isinstance(e, dict) and i != "-" and str(e.get("id")) == i:
        er = e.get("risk") if isinstance(e.get("risk"), str) else ""
if er is None: print(fr); sys.exit(0)
print(max([fr, er or "-"], key=lambda r: rank.get(r, 4)))
' "$2" "$3" 2>/dev/null || echo unverifiable
}
# journal_once <text>: the journal line, unless it equals this folder's last dispatch line today
last_line() {
  awk -v f="$F" '/^## /{h=$0; sub(/^## [^·]*· /,"",h); next} /^dispatch/ && h==f {l=$0} END{print l}' "$H/journal/$(utc_today).md" 2>/dev/null
}
join() { local IFS=,; [ $# -gt 0 ] && echo "$*" | sed 's/,/, /g' || echo none; }

if [ "$LIST" = 1 ]; then   # read-only: a line per ticket, nothing started or written
  while IFS="$(printf '\t')" read -r k ref risk hitl id hasfile; do
    case "$k" in
      R) if runs "$(name_of "$ref")"; then st=running
         else st=ready; [ "$hitl" != 1 ] || st=waiting
           if [ "$st" = ready ] && [ "${hasfile:-0}" = 1 ] && { [ "$risk" = low ] || [ "$risk" = medium ]; }; then risk="$(risk_of "$ref" "$risk" "${id:--}")"; fi
           case "$risk" in low|medium) ;; *) st=waiting ;; esac
         fi ;;
      O) [ "$risk" = in_progress ] && runs "$(name_of "$ref")" || continue; st=running ;;   # an O row's third field is its group
      *) continue ;;
    esac
    printf '%s\t%s\t%s\n' "$st" "$ref" "$F"
  done <<< "$rows"
  exit 0
fi
if [ -n "$APPROVE" ]; then
  line=$(printf '%s\n' "$rows" | awk -F'\t' -v r="$APPROVE" '$2==r {print; exit}')
  case "$line" in
    R*) ;;
    O*) echo "dispatch: $APPROVE is $(printf "%s" "$line" | cut -f3), not ready to start; nothing started" >&2; exit 1 ;;
    *) echo "dispatch: no ticket '$APPROVE' in $F's tickets next; nothing started" >&2; exit 1 ;;
  esac
  n="$(name_of "$APPROVE")"
  runs "$n" && { echo "dispatch: $APPROVE already runs (session $n); nothing started" >&2; exit 1; }
  [ "$free" -gt 0 ] || { echo "dispatch: no free slot (HUB_DISPATCH_MAX $MAX, $used running); nothing started" >&2; exit 1; }
  # the owner's gate: an interactive terminal, and the ref typed back there (an agent's tool call has no terminal; the
  # folder settings make Claude Code ask before `bin/dispatch --approve` and `script`)
  if ! [ -t 0 ] || ! [ -t 1 ] || ! { : </dev/tty; } 2>/dev/null; then
    echo "dispatch: --approve needs the owner at an interactive terminal; nothing started" >&2; exit 1
  fi
  printf 'Start %s in %s (it waits for the owner)? Type the ref to confirm: ' "$APPROVE" "$F" >/dev/tty
  typed=""; read -r -t 120 typed </dev/tty || true
  [ "$typed" = "$APPROVE" ] || { echo "dispatch: not confirmed; nothing started" >&2; exit 1; }
  if start "$APPROVE"; then
    echo "started: $APPROVE (approved at the terminal)"; "$B/journal" "$F" "dispatch: started $APPROVE (approved at the terminal)" >/dev/null; exit 0
  fi
  echo "dispatch: bin/work failed for $APPROVE" >&2
  "$B/journal" "$F" "dispatch: bin/work failed for $APPROVE (approved at the terminal)" >/dev/null; exit 1
fi

STARTED=(); WAITING=(); FAILED=""
while IFS="$(printf '\t')" read -r k ref risk hitl id hasfile; do
  case "$k" in
    B) echo "skipped: a ready ticket with a ref dispatch does not take: $ref" ;;
    R) n="$(name_of "$ref")"
      if runs "$n"; then echo "running: $ref (session $n)"; continue; fi
      why=""
      [ "$hitl" = 1 ] && why="hitl"
      if [ -z "$why" ] && [ "${hasfile:-0}" = 1 ] && { [ "$risk" = low ] || [ "$risk" = medium ]; }; then risk="$(risk_of "$ref" "$risk" "${id:--}")"; fi
      case "$risk" in low|medium) ;; high) why="${why:+$why, }high risk" ;; -) why="${why:+$why, }risk not set" ;; unverifiable) why="${why:+$why, }risk cannot be checked" ;; *) why="${why:+$why, }risk $risk" ;; esac
      if [ -n "$why" ]; then
        WAITING+=("$ref"); echo "waiting for the owner: $ref ($why); start it with bin/dispatch --approve $ref $F"; continue
      fi
      [ -z "$FAILED" ] || continue
      if [ "$free" -le 0 ]; then echo "ready, no free slot: $ref"; continue; fi
      if start "$ref"; then STARTED+=("$ref"); free=$((free - 1)); echo "started: $ref"
      else FAILED="$ref"; echo "dispatch: bin/work failed for $ref; no more starts this run" >&2; fi ;;
  esac
done <<< "$rows"
msg="dispatch: started $(join ${STARTED[@]+"${STARTED[@]}"}); waiting for the owner: $(join ${WAITING[@]+"${WAITING[@]}"})"
[ -z "$FAILED" ] || msg="$msg; bin/work failed for $FAILED"
if [ ${#STARTED[@]} -gt 0 ] || [ -n "$FAILED" ] || [ "$(last_line)" != "$msg" ]; then "$B/journal" "$F" "$msg" >/dev/null; fi
[ -z "$FAILED" ]
