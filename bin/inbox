#!/bin/bash
# bin/inbox [folder]: PostToolUse hook (hub root and every folder; no model). Records a Bash `git push` as a `pushed`
# event (repo, branch) and an Edit/Write under a checkout's .ade/context/ as a `contract` event (repo, path), then
# delivers this session's unread events from $(state_dir)/events.jsonl as additionalContext JSON, at most once per 60 s
# per session (hook stdin session_id), each line marked as data, not instructions. Story C6, .ade/context/events.md.
# Cheap path first, in bash: a call that mentions neither a push nor .ade/context/ starts no python when the log is
# not newer than the session's cursor or its last delivery is under 60 s old. Reads stdin for at most 1 s (a stdin
# that never closes counts as empty); always exits 0 (a broken log never blocks a session).
# bin/inbox --count [main|<folder>|<name>] (story H1, .ade/context/hub-interface.md): the number of unread events for that
# session (default main): a bin/sessions NAME (its folder), projects/<name>, ops/<name> or a bare folder name. Counted
# after the folder's last delivery (<state dir>/events-read/), else what its first delivery would show; 0 once read.
# Reads no stdin and writes nothing. Exit 0 a number, 1 the log is unusable, 2 an unknown name.
if [ "${1:-}" = --count ]; then
  set -u; . "$(dirname "$0")/lib.sh"; H="$(hub_root)"; [ $# -le 2 ] || { echo "usage: bin/inbox --count [main|folder|session]" >&2; exit 2; }
  N="${2:-main}"; O=""; SD="$(state_dir)/sessions"
  folder_ok() { [[ "$1" =~ ^(projects|ops)/[A-Za-z0-9._-]+$ ]] && [ "${1##*/}" != . ] && [ "${1##*/}" != .. ] && [ -d "$H/$1" ]; }
  case "$N" in
    main) O=main ;;
    */*) folder_ok "$N" && O="$N" ;;
    *) if [[ "$N" =~ ^[A-Za-z0-9._-]+$ ]]; then
         for e in "$SD/$N".*; do [ -f "$e" ] && [ "$(sed -n 's/^name=//p' "$e" | head -1)" = "$N" ] || continue
           O="$(sed -n 's/^folder=//p' "$e" | head -1)"; folder_ok "$O" || O=""; break; done
         if [ -z "$O" ]; then m=""; for t in projects ops; do folder_ok "$t/$N" && m="$m $t/$N"; done; set -- $m; [ $# -ne 1 ] || O="$1"; fi
       fi ;;
  esac
  [ -n "$O" ] || { echo "inbox: no session or folder named '$N'" >&2; exit 2; }
  R=""; [ "$O" = main ] || R="$(repos_of "$O" 2>/dev/null)"
  H="$H" ST="$(state_dir)" REPOS="$R" exec python3 -I "$(dirname "$0")/events.py" count "$O"
fi
. "$(dirname "$0")/lib.sh" 2>/dev/null || exit 0
F="${1:-}"; IN=""; IFS= read -r -d '' -t 1 IN
re='"session_id"[[:space:]]*:[[:space:]]*"([A-Za-z0-9_-]{1,80})"'; SID=""; [[ "$IN" =~ $re ]] && SID="${BASH_REMATCH[1]}"
ST="$(state_dir)"; E="$ST/events.jsonl"; C="$ST/events-seen/$SID"
# Check-in (story S1, .ade/context/events.md): a folder session is told once per HUB_CHECKIN_MINUTES of work to update
# its STATE.md, then note main. Bash builtins, date and touch only: <state>/checkin/<folder>.start (period start),
# .seen (last call), .nudged; each holds one epoch. A missing start, an idle gap of N minutes, or a STATE.md newer than
# .start restarts the period (bin/notify main from the session does too). A call mentioning push or /.ade/context/ (a
# push or contract call) is never nudged (its event goes to python below); a nudge is the whole output of its call
# (delivery waits for the next call).
if [ -n "$F" ]; then
  CN=$(checkin_minutes)
  if [ "$CN" -gt 0 ] && { [ -d "$ST/checkin" ] || mkdir -p "$ST/checkin" 2>/dev/null; }; then
    K="$ST/checkin/${F//[^A-Za-z0-9]/-}"; HR="$(hub_root)"; now=$(date +%s); cs=""; cw=""; cg=""
    [ -f "$K.start" ] && read -r cs < "$K.start"; [[ "$cs" =~ ^[0-9]{1,12}$ ]] || cs=""
    [ -f "$K.seen" ] && read -r cw < "$K.seen"; [[ "$cw" =~ ^[0-9]{1,12}$ ]] || cw=""
    [ -f "$K.nudged" ] && read -r cg < "$K.nudged"; [[ "$cg" =~ ^[0-9]{1,12}$ ]] || cg=0
    if [ -z "$cs" ] || { [ -n "$cw" ] && [ $(( now - cw )) -ge $(( CN * 60 )) ]; } || [ "$HR/$F/STATE.md" -nt "$K.start" ]; then
      cs=$now; printf '%s\n' "$now" > "$K.start" 2>/dev/null
    fi
    printf '%s\n' "$now" > "$K.seen" 2>/dev/null
    case "$IN" in *push*|*/.ade/context/*) ;; *)
      if [ $(( now - cs )) -ge $(( CN * 60 )) ] && ! [ "$cg" -gt "$cs" ]; then
        printf '%s\n' "$now" > "$K.nudged" 2>/dev/null
        js() { local s="$1"; s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; printf '%s' "$s"; }
        printf '{"hookSpecificOutput":{"hookEventName":"PostToolUse","additionalContext":"%s"}}\n' \
          "[hub check-in, from the hub's PostToolUse hook, not from the owner] About $(( (now - cs) / 60 )) minutes of work since your last check-in. Check in now: update $(js "$HR/$F/STATE.md") (progress, next step, blockers), then run: $(js "$HR/bin/notify") main \\\"<progress, next step, blocker if any>\\\" (one line). Do not commit the hub for this: bin/sync picks the files up."
        exit 0
      fi ;;
    esac
  fi
fi
case "$IN" in
  *push*|*/.ade/context/*) ;;
  *) [ -n "$SID" ] || exit 0
     # no log yet: this session's baseline is the empty log (it will read every event from the first one)
     [ -f "$E" ] || { [ -f "$C" ] || { mkdir -p "$ST/events-seen" 2>/dev/null && printf '0 0\n' > "$C" 2>/dev/null; }; exit 0; }
     [ -f "$C" ] && [ "$C" -nt "$E" ] && exit 0
     if [ -f "$C.at" ]; then a=$(file_mtime "$C.at"); [ -n "$a" ] && [ $(( $(date +%s) - a )) -lt 60 ] && exit 0; fi ;;
esac
R=""; [ -z "$F" ] || R="$(repos_of "$F" 2>/dev/null)"
printf '%s' "$IN" | H="$(hub_root)" ST="$ST" REPOS="$R" python3 -I "$(dirname "$0")/events.py" hook-tool "$F" 2>/dev/null
exit 0
