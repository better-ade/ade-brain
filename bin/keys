#!/bin/bash
# bin/keys: the key for each AI tool, in this hub's Keychain. Never prints a value, and a stored key enables nothing.
#   bin/keys                 each tool: stored or missing, and what it still needs
#   bin/keys set <tool>      store or replace its key (hidden prompt or stdin, never an argument), then says where
#   bin/keys forget <tool>   remove its key
#   bin/keys share <github-user|age1…> [<tool|secret> …] [--all] [--days N] [-i <ssh key>] [--as <github-user>] [--unsigned]
#                            seal keys with age to one person (story I4): their GitHub ssh-ed25519/ssh-rsa keys or an age1…
#                            key; shows the fingerprints and asks (a "y" on stdin); the armored block alone on stdout.
#                            Signed inside the seal with your ssh key as your GitHub user (story I5). --link: the block
#                            goes to a one-time secret on HUB_ONETIME_URL and only its https link is printed (story I6)
#   bin/keys receive [file|link] [-i <identity>] [--any-hub] [--any-to] [--from <github-user>]
#                            open a block (a file, stdin, or a one-time link on HUB_ONETIME_URL's host, fetched once)
#                            straight into this hub's store; checks a signature against the
#                            signer's GitHub keys; shows what it holds and asks once before storing anything, then again
#                            before replacing a key
#   bin/keys receive --new   make a one-off age identity (~/.config/ade/age/key.txt) and print its public key
# A shared value goes store -> shell variable -> pipe -> age, and back: never a file, an argument or output.
# Contract: .ade/context/keys-share.md; the one-time link service: .ade/context/onetime-secret.md.
# anthropic is optional: a stored Anthropic API key is used through apiKeyHelper by bin/agent --live-test, and by role runs
# only with HUB_AGENT_ANTHROPIC_KEY=1 in hub.conf (story H1, ADR 0002); otherwise bin/agent uses the Claude login. Contract: .ade/context/providers.md, "Keys", and .ade/context/hub-interface.md.
set +x; unset BASH_ENV   # an inherited xtrace (SHELLOPTS) or BASH_ENV would print or run code next to the values
set -u; . "$(dirname "$0")/lib.sh"; H="$(hub_root)"
USAGE="usage: bin/keys | bin/keys set <tool> | bin/keys forget <tool> | bin/keys share <github-user|age1…> [<tool|secret> …] [--all] [--days N] [-i <ssh key>] [--as <github-user>] [--unsigned] [--link] | bin/keys receive [file|link] [-i <identity>] [--any-hub] [--any-to] [--from <github-user>] | bin/keys receive --new (tools: $(key_tools))"
bad() { echo "$USAGE" >&2; exit 2; }
# the hub's secret store (bin/lib.sh, story V1): the Keychain on macOS, pass or the file store on Linux
keychain() { local why; why="$(secret_store_refusal)"; [ -z "$why" ] || { echo "keys: $why" >&2; exit 1; }; }
# an unknown name is not repeated: it may be a key typed in the wrong place
tool_name() { case " $(key_tools) " in *" $1 "*) key_secret "$1" ;; *) echo "keys: unknown tool" >&2; bad ;; esac; }
# tool_state <tool>: what stands between this tool and a run, other than its key (empty = nothing)
tool_state() {
  case "$1" in telegram|anthropic) return 0 ;; esac   # a chat channel's bot token (bin/chat); Anthropic needs no gate
  local why
  if [ "$(engine_of "$1")" = gemini ]; then why="$(candidate_refusal "gemini:gemini-2.5-pro")"
  else provider_field "$1" base_url >/dev/null 2>&1 || { echo "$1 is not connected yet"; return 0; }; why="$(candidate_refusal "$1:sonnet")"; fi
  case "$why" in "no "*" in the Keychain"*|"no Gemini sign-in"*) ;; *) printf '%s' "$why" ;; esac
}
# --- share / receive (story I4, .ade/context/keys-share.md) ---
need_age() { local t; for t in age "$@"; do command -v "$t" >/dev/null 2>&1 || { echo "keys: $t is not installed: $(tool_install_line age)" >&2; exit 1; }; done; }
# keys_now: seconds since 1970 (AGENT_KEYS_NOW, a test-only clock, counts only with AGENT_PLATFORM_TEST=1)
keys_now() { if [ "${AGENT_PLATFORM_TEST:-}" = 1 ] && [[ "${AGENT_KEYS_NOW:-}" =~ ^[0-9]+$ ]]; then echo "$AGENT_KEYS_NOW"; else date -u +%s; fi; }
age_dir() { echo "${XDG_CONFIG_HOME:-$HOME/.config}/ade/age"; }
# shown: text from a block (someone else's), printable characters only and short
shown() { printf '%s' "$1" | LC_ALL=C tr -cd '[:print:]' | cut -c1-80; }
# gh_user_ok <name>: a GitHub user name (it goes into a URL and an allowed_signers principal)
gh_user_ok() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9-]*$ ]] && [ "${#1}" -le 39 ]; }
# github_keys <user>: the public keys GitHub publishes for <user>, https only, at most 1 MiB. In tests
# (AGENT_PLATFORM_TEST=1) only AGENT_GITHUB_KEYS_URL, a file or URL where {user} stands for <user>; never GitHub
github_keys() { local u="https://github.com/$1.keys"
  if [ "${AGENT_PLATFORM_TEST:-}" = 1 ]; then u="${AGENT_GITHUB_KEYS_URL:-}"
    [ -n "$u" ] || { echo "keys: a test run reads keys only from AGENT_GITHUB_KEYS_URL" >&2; return 1; }; u="${u//\{user\}/$1}"; fi
  case "$u" in /*) cat -- "$u" ;; *) curl --proto '=https,file' --proto-redir '=https' --tlsv1.2 --max-filesize 1048576 -fsSL -m 20 -- "$u" ;; esac; }
# --- one-time link (story I6, .ade/context/onetime-secret.md): the armored block alone, as an anonymous secret on a
# Onetime Secret instance (its v3 guest API); the link opens once. Only the sealed block ever goes there.
# onetime_base: HUB_ONETIME_URL (default the public instance's API host), https://<host>[:port] only, never a path, a user
# or a query; prints it without a trailing /, else says why and fails
onetime_base() { local u="${HUB_ONETIME_URL:-https://us.onetimesecret.com}"
  [[ "$u" =~ [[:space:][:cntrl:]] ]] && { echo "keys: HUB_ONETIME_URL holds whitespace or a control character; nothing sent" >&2; return 1; }; u="${u%/}"
  [[ "$u" =~ ^https://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:[0-9]{1,5})?$ ]] ||
    { echo "keys: HUB_ONETIME_URL must be https://<host> (no path, user or query): $(shown "$u"); nothing sent" >&2; return 1; }
  printf '%s' "$u"; }
# onetime_post <path>: POST the JSON body on stdin to the API; prints the answer, a newline and the HTTP code (000: no
# answer). Never follows a redirect. In tests (AGENT_PLATFORM_TEST=1) only AGENT_ONETIME_API, a local
# http://127.0.0.1:<port>, never a real service; AGENT_ONETIME_TIMEOUT (seconds) is test-only too
onetime_post() { local api proto='=https' to=20
  if [ "${AGENT_PLATFORM_TEST:-}" = 1 ]; then api="${AGENT_ONETIME_API:-}"
    [[ "$api" =~ ^http://127\.0\.0\.1:[0-9]{1,5}$ ]] || { echo "keys: a test run sends only to AGENT_ONETIME_API (http://127.0.0.1:<port>), never a real service" >&2; return 1; }
    proto='=http'; [[ "${AGENT_ONETIME_TIMEOUT:-}" =~ ^[1-9][0-9]{0,2}$ ]] && to="$AGENT_ONETIME_TIMEOUT"
  else api="$1"; fi
  curl -q --proto "$proto" --proto-redir '=https' --tlsv1.2 -sS --max-filesize 1048576 -m "$to" -H 'Content-Type: application/json' \
    -H 'Accept: application/json' --data-binary @- -w '\n%{http_code}' -- "$api$2" 2>/dev/null; return 0; }
# onetime_share <base> <armor> <ttl>: makes the secret; prints its link (<base>/secret/<id>), else says why and fails
onetime_share() { local r code id
  # the armor is base64, "-" and spaces: nothing in it needs JSON escaping; anything else is not sent
  printf '%s\n' "$2" | grep -qvE '^[A-Za-z0-9+/= -]*$' && { echo "keys: the block holds a character it should not" >&2; return 1; }
  r="$(printf '%s\n' "$2" | awk -v ttl="$3" 'BEGIN { printf "{\"secret\":{\"ttl\":%d,\"secret\":\"", ttl } NR > 1 { printf "\\n" } { printf "%s", $0 } END { printf "\"}}" }' |
    onetime_post "$1" /api/v3/guest/secret/conceal)" || return 1
  code="${r##*$'\n'}"; r="${r%$'\n'*}"; [[ "$code" =~ ^[0-9]{3}$ ]] || code=000
  [ "$code" = 200 ] || { if [ "$code" = 000 ]; then echo "keys: $1 did not answer (timeout or network)" >&2; else echo "keys: $1 answered HTTP $(shown "$code")" >&2; fi; return 1; }
  id="$(printf '%s' "$r" | python3 -I -c 'import json, sys
s = json.load(sys.stdin)["record"]["secret"]; print(s.get("identifier") or s.get("key") or "")' 2>/dev/null)"
  [[ "$id" =~ ^[A-Za-z0-9]{20,128}$ ]] || { echo "keys: $1 gave no secret id" >&2; return 1; }
  printf '%s/secret/%s\n' "$1" "$id"; }
share() {
  local link=0 base="" url ttl
  local to="" names="" all=0 days=7 kind n s i=0 list="" count=0 keys k ans armor now exp sigkey="" sigarg=0 unsigned=0 signer="" sfp="" p sig="" pk ok; local R=()
  while [ $# -gt 0 ]; do case "$1" in
      --all) all=1 ;;
      -i) [ -n "${2:-}" ] || bad; sigkey="$2"; sigarg=1; shift ;;
      --unsigned) unsigned=1 ;;
      --link) link=1 ;;
      --as) gh_user_ok "${2:-}" || { echo "keys: --as takes a GitHub user name" >&2; exit 2; }; signer="$2"; shift ;;
      --days) [[ "${2:-}" =~ ^[0-9]+$ ]] && [ "$2" -ge 1 ] && [ "$2" -le 30 ] || { echo "keys: --days takes 1 to 30" >&2; exit 2; }; days=$((10#$2)); shift ;;
      -*) bad ;;
      *) if [ -z "$to" ]; then to="$1"; else names="$names $1"; fi ;;
    esac; shift; done
  [ -n "$to" ] || bad
  # --link: the service is checked before anything else, so a bad HUB_ONETIME_URL sends nothing
  if [ "$link" = 1 ]; then base="$(onetime_base)" || exit 2; fi
  # the recipient: an age1… key or a GitHub user name; never a file or a path (a recipients file is never taken)
  # an age1 key is an X25519 key only (bech32, 58 characters after age1): a plugin recipient (age1<name>1…) is refused
  if [[ "$to" =~ ^age1[02-9ac-hj-np-z]{58}$ ]]; then kind=age
  elif gh_user_ok "$to" && [ ! -e "$to" ]; then kind=github
  else echo "keys: the recipient is a GitHub user name or an age1… key (bin/keys receive --new), never a file or a path; nothing sealed" >&2; exit 2; fi
  need_age; keychain
  # the signing key (story I5): -i (a private key, or a .pub whose key is in ssh-agent), else ~/.ssh/id_ed25519;
  # --unsigned: none (format v1)
  [ "$unsigned" = 0 ] || [ "$sigarg" = 0 ] || { echo "keys: -i signs; --unsigned does not: pass one of them" >&2; exit 2; }
  if [ "$unsigned" = 1 ]; then echo "keys: --unsigned: the block is unsigned and shows as not verified" >&2
  elif [ -n "$sigkey" ]; then [ -f "$sigkey" ] || { echo "keys: no ssh key at $sigkey; nothing sealed" >&2; exit 1; }
  elif [ -f "$HOME/.ssh/id_ed25519" ]; then sigkey="$HOME/.ssh/id_ed25519"; fi
  # the signer: --as, else the GitHub user gh is signed in as
  if [ -n "$sigkey" ] && [ -z "$signer" ] && command -v gh >/dev/null 2>&1; then
    signer="$(timeout 10 gh api user --jq .login 2>/dev/null < /dev/null)" || signer=""; gh_user_ok "$signer" || signer=""; fi
  if [ -n "$sigkey" ] && [ -z "$signer" ]; then
    [ "$sigarg" = 0 ] || { echo "keys: -i signs as a GitHub user: add --as <github-user> (or sign in with gh); nothing sealed" >&2; exit 2; }
    echo "keys: no GitHub user to sign as (--as <github-user>, or sign in with gh): the block is unsigned and shows as not verified" >&2; sigkey=""
  elif [ -z "$sigkey" ] && [ "$unsigned" = 0 ]; then echo "keys: no ssh key to sign with (~/.ssh/id_ed25519, or -i <ssh key>): the block is unsigned and shows as not verified" >&2; fi
  # the signing key must be one the signer publishes on GitHub (receive checks against those): -i that is not: refused;
  # the default key that is not: a warning, and the block is unsigned
  if [ -n "$sigkey" ]; then ok=0
    sfp="$(ssh-keygen -lf "$sigkey" < /dev/null 2>/dev/null | cut -d' ' -f2)"
    if [ -n "$sfp" ] && pk="$(github_keys "$signer")"; then local IFS=$'\n'; set -f
      for k in $(printf '%s\n' "$pk" | tr -d '\r' | grep -E '^[a-z0-9-]+ [A-Za-z0-9+/]+=*( .*)?$'); do
        [ "$(printf '%s\n' "$k" | ssh-keygen -lf - 2>/dev/null | cut -d' ' -f2)" != "$sfp" ] || ok=1; done
      set +f; unset IFS; fi
    if [ "$ok" = 0 ]; then
      [ "$sigarg" = 0 ] || { echo "keys: the key ${sfp:-?} ($sigkey) is not among $signer's keys on GitHub (https://github.com/$signer.keys), so the receiver could not check the signature; nothing sealed (add it to $signer's GitHub keys, or --unsigned)" >&2; exit 1; }
      echo "keys: your key ${sfp:-?} ($sigkey) is not among $signer's keys on GitHub: the block is unsigned and shows as not verified (-i <a key $signer publishes>, or --as <the user who does>)" >&2; sigkey=""; sfp=""
    fi
  fi
  [ "$all" = 0 ] || names="$names $(secret_names | tr '\n' ' ')"
  set -f
  for n in $names; do i=$((i + 1))
    case " $(key_tools) " in *" $n "*) s="$(key_secret "$n")" ;; *) s="$n" ;; esac
    # an unknown name is not repeated: it may be a value typed in the wrong place
    secret_name_ok "$s" && secret_has "$s" || { set +f; echo "keys: name $i is neither a tool with a stored key nor a stored secret; nothing sealed" >&2; exit 1; }
    case " $list " in *" $s "*) ;; *) list="$list $s"; count=$((count + 1)) ;; esac
  done
  set +f
  [ "$count" -gt 0 ] || { [ "$all" = 1 ] && { echo "keys: nothing stored to share" >&2; exit 1; }; echo "keys: name the keys to share (a tool or a secret name), or --all" >&2; exit 2; }
  if [ "$kind" = age ]; then R=(-r "$to"); echo "keys: sealing to the age key $to" >&2
  else
    keys="$(github_keys "$to")" || { echo "keys: could not read $to's public keys from GitHub; nothing sealed" >&2; exit 1; }
    keys="$(printf '%s\n' "$keys" | tr -d '\r' | grep -E '^(ssh-ed25519|ssh-rsa) [A-Za-z0-9+/]+=*( .*)?$')"
    [ -n "$keys" ] || { echo "keys: $to has no ssh-ed25519 or ssh-rsa key on GitHub; nothing sealed (they can run bin/keys receive --new and send you its age1… key)" >&2; exit 1; }
    echo "keys: $to's keys on GitHub (check them with $to):" >&2
    local IFS=$'\n' fp bits; set -f
    for k in $keys; do k="$(printf '%s' "$k" | cut -d' ' -f1,2)"
      fp="$(printf '%s\n' "$k" | ssh-keygen -lf - 2>/dev/null)"; bits="${fp%% *}"
      if ! [[ "$bits" =~ ^[0-9]+$ ]]; then echo "  skipped: a ${k%% *} key ssh-keygen cannot read (…${k: -12})" >&2; continue; fi
      if [ "${k%% *}" = ssh-rsa ] && [ "$bits" -lt 2048 ]; then echo "  skipped: $fp (ssh-rsa under 2048 bits)" >&2; continue; fi
      R+=(-r "$k"); echo "  $fp" >&2; done
    set +f; unset IFS
    [ "${#R[@]}" -gt 0 ] || { echo "keys: none of $to's keys on GitHub can be used; nothing sealed (they can run bin/keys receive --new and send you its age1… key)" >&2; exit 1; }
  fi
  [ -z "$sigkey" ] || echo "keys: signing as $signer with $sfp ($sigkey)" >&2
  [ "$link" = 0 ] || echo "keys: --link: the sealed block goes to ${base#https://} as a one-time link, expiring in $(( days < 7 ? days : 7 )) day(s)" >&2
  printf 'keys: seal%s for %s, expiring in %s day(s)? [y/N] ' "$list" "$to" "$days" >&2
  read -r ans || ans=""; [ -t 0 ] || echo >&2   # an answer from a pipe echoes no newline
  case "$ans" in y|Y|yes|Yes|YES) ;; *) echo "keys: nothing sealed" >&2; exit 1 ;; esac
  now="$(keys_now)"; exp=$((now + days * 86400))
  # the plaintext (format v1, or v2 when signed): held in a shell variable and written into pipes (ssh-keygen, then age),
  # never to a file; a value that cannot be read leaves no "end"
  seal_plain() { local n v
    if [ -n "$sigkey" ]; then printf 'ade-keys-share 2\nhub: %s\nfrom: %s\nsigner: %s\n' "$(hub_name)" "$(hub_user)" "$signer"
    else printf 'ade-keys-share 1\nhub: %s\nfrom: %s\n' "$(hub_name)" "$(hub_user)"; fi
    printf 'to: %s\ntime: %s\nexpires: %s\n' "$to" "$(utc_iso "$now")" "$(utc_iso "$exp")"
    set -f; for n in $list; do v="$(secret_get "$n")" && [ -n "$v" ] || { echo "keys: could not read $n from $(secret_store_label)" >&2; return 1; }
      case "$v" in *$'\n'*) echo "keys: $n holds more than one line; nothing sealed" >&2; return 1 ;; esac
      printf 'secret %s %s\n' "$n" "$v"; done; unset v
    echo end; }
  p="$(seal_plain)" || { unset p; echo "keys: nothing sealed" >&2; exit 1; }
  # v2: the signature over the plaintext through "end" (ssh-keygen -Y sign reads it on stdin), sealed with it after "end"
  if [ -n "$sigkey" ]; then
    sig="$(printf '%s\n' "$p" | ssh-keygen -Y sign -f "$sigkey" -n ade-keys 2>/dev/null)" && [ -n "$sig" ] ||
      { unset p; echo "keys: signing with $sigkey failed (a key with a passphrase: add it to ssh-agent and pass its .pub with -i, or seal unsigned with --unsigned); nothing sealed" >&2; exit 1; }
  fi
  armor="$(set -o pipefail; { printf '%s\n' "$p"; [ -z "$sig" ] || printf '%s\n' "$sig"; } | age -a "${R[@]}")" || { unset p; echo "keys: sealing failed; nothing printed" >&2; exit 1; }
  unset p
  # --link: the sealed block (never a value) becomes a one-time secret; the link expires with the block, at most the 7 days
  # the service keeps an anonymous secret. On any failure the block is printed as without --link, and the exit is 1
  if [ "$link" = 1 ]; then ttl=$(( (days < 7 ? days : 7) * 86400 ))
    if url="$(onetime_share "$base" "$armor" "$ttl")"; then printf '%s\n' "$url"
      [ "$days" -le 7 ] || echo "keys: the link stops at 7 days (the service's limit for an anonymous secret); the block inside is good until $(utc_iso "$exp")" >&2
      echo "keys: sealed $count key(s) for $to, until $(utc_iso "$exp"), as a one-time link (it opens once). Send the link above any way; only $to can open what it holds, with bin/keys receive <link>." >&2
      return 0; fi
    printf '%s\n' "$armor"
    echo "keys: the one-time link failed; the block above is sealed for $to until $(utc_iso "$exp"): send it any way, and $to opens it with bin/keys receive." >&2
    exit 1; fi
  printf '%s\n' "$armor"
  echo "keys: sealed $count key(s) for $to, until $(utc_iso "$exp"). Send the block above any way; only $to can open it, with bin/keys receive." >&2
}
# ask: a yes from stdin when the block came from a file, else from the terminal; no answer keeps the old value
ask() { local a=""
  if [ "$FROM_FILE" = 1 ]; then read -r a || a=""; [ -t 0 ] || echo >&2
  else { read -r a < /dev/tty; } 2>/dev/null || { a=""; echo >&2; }; fi
  case "$a" in y|Y|yes|Yes|YES) return 0 ;; esac; return 1; }
# verify_block: the v2 signature (the lines after "end") over L[0..endi], checked with ssh-keygen -Y verify against the
# keys GitHub publishes for the signer (story I5); sets sfp to the signing key's fingerprint, else refuses. The data goes
# to ssh-keygen on stdin; only the signature and the public keys are written to a private temp folder.
verify_block() {
  local d keys t k fp bits out sigl=("${L[@]:$((endi + 1))}") j
  [ "${#sigl[@]}" -ge 3 ] && [ "${sigl[0]}" = "-----BEGIN SSH SIGNATURE-----" ] && [ "${sigl[$((${#sigl[@]} - 1))]}" = "-----END SSH SIGNATURE-----" ] ||
    refuse "the block's signature is missing or malformed"
  for ((j = 1; j < ${#sigl[@]} - 1; j++)); do [[ "${sigl[$j]}" =~ ^[A-Za-z0-9+/=]+$ ]] || refuse "the block's signature is malformed"; done
  keys="$(github_keys "$bsigner")" || refuse "could not read $bsigner's public keys from GitHub to check the signature"
  # the temp folder goes on any exit, and on a signal
  trap 'rm -rf "${VTMP:-}"' EXIT; trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM
  d="$(mktemp -d "${TMPDIR:-/tmp}/ade-keys.XXXXXX")" || exit 1; VTMP="$d"
  # allowed_signers: "<signer> namespaces="ade-keys" <type> <key>", ssh-rsa under 2048 bits left out (as share does)
  local IFS=$'\n'; set -f
  for k in $(printf '%s\n' "$keys" | tr -d '\r' | grep -E '^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)) [A-Za-z0-9+/]+=*( .*)?$'); do
    k="$(printf '%s' "$k" | cut -d' ' -f1,2)"; fp="$(printf '%s\n' "$k" | ssh-keygen -lf - 2>/dev/null)"; bits="${fp%% *}"
    [[ "$bits" =~ ^[0-9]+$ ]] || continue; [ "${k%% *}" != ssh-rsa ] || [ "$bits" -ge 2048 ] || continue
    printf '%s namespaces="ade-keys" %s\n' "$bsigner" "$k"; done > "$d/signers"
  set +f; unset IFS
  [ -s "$d/signers" ] || { rm -rf "$d"; refuse "$bsigner publishes no ssh key on GitHub that can check the signature"; }
  printf '%s\n' "${sigl[@]}" > "$d/sig"
  out="$(printf '%s\n' "${L[@]:0:$((endi + 1))}" | ssh-keygen -Y verify -f "$d/signers" -I "$bsigner" -n ade-keys -s "$d/sig" 2>/dev/null)" ||
    { rm -rf "$d"; refuse "the signature does not match $bsigner's keys on GitHub (changed after signing, or signed with a key $bsigner does not publish)"; }
  rm -rf "$d"
  sfp="$(printf '%s\n' "$out" | grep -oE 'SHA256:[A-Za-z0-9+/]+' | head -1)"; [ -n "$sfp" ] || refuse "ssh-keygen did not name the signing key"
}
# to_is_me <to>: one of the receiver's identities (ids: -i <file> pairs) is <to>: an age1… key that age-keygen -y gives
# for an identity, or a GitHub user who publishes the public key of an ssh identity; refuses when those keys cannot be read
to_is_me() { local to="$1" i f pk pubs="" k
  if [[ "$to" =~ ^age1[02-9ac-hj-np-z]{58}$ ]]; then
    for ((i = 1; i < ${#ids[@]}; i += 2)); do [ "$(age-keygen -y "${ids[$i]}" 2>/dev/null < /dev/null)" != "$to" ] || return 0; done; return 1; fi
  gh_user_ok "$to" || return 1
  pubs="$(github_keys "$to")" || refuse "could not read $to's public keys from GitHub to check the block is for you"
  pubs="$(printf '%s\n' "$pubs" | tr -d '\r' | cut -d' ' -f1,2)"
  for ((i = 1; i < ${#ids[@]}; i += 2)); do f="${ids[$i]}"
    if [ -f "$f.pub" ]; then pk="$(cut -d' ' -f1,2 < "$f.pub")"; else pk="$(ssh-keygen -y -P '' -f "$f" 2>/dev/null < /dev/null | cut -d' ' -f1,2)"; fi
    [ -n "$pk" ] || continue
    while IFS= read -r k; do [ "$k" != "$pk" ] || return 0; done <<< "$pubs"; done
  return 1; }
# refuse <why>: nothing stored, exit 1
refuse() { unset plain L vals; echo "keys: refused: $1; nothing stored" >&2; keep_block; exit 1; }
# keep_block: a block fetched from a link (which opens once) is not lost when receive stops short: the sealed armor
# alone goes to a 0600 file in a 0700 folder, and the receiver retries from it (bin/keys receive <file> [-i <identity>]);
# if it cannot be written, the armor goes to stderr instead. It is ciphertext: only the receiver's key opens it.
keep_block() { local d f; [ "${KEEP:-0}" = 1 ] && [ -n "${armor:-}" ] || return 0; KEEP=0
  d="${XDG_CONFIG_HOME:-$HOME/.config}/ade/links"; f="$d/$id.age"
  if ( umask 077; mkdir -p "$d" ) 2>/dev/null && chmod 700 "$d" && ( umask 077; printf '%s\n' "$armor" > "$f" ) 2>/dev/null && chmod 600 "$f"; then
    echo "keys: the link is used up; its sealed block is kept in $f (only your key opens it): bin/keys receive $f [-i <identity>]" >&2
  else echo "keys: the link is used up and $d could not hold its block; here it is (sealed; save it, then bin/keys receive <file>):" >&2
    printf '%s\n' "$armor" >&2; fi; }
new_identity() {
  local d f pub; need_age age-keygen; d="$(age_dir)"; f="$d/key.txt"
  if [ ! -d "$d" ]; then ( umask 077; mkdir -p "$d" ) && chmod 700 "$d" || { echo "keys: cannot make $d" >&2; exit 1; }; fi
  [ "$(file_low9 "$d")" = 700 ] && [ "$(file_owner "$d")" = "$(id -u)" ] || { echo "keys: $d must be a 0700 folder of yours: chmod 700 $d" >&2; exit 1; }
  if [ -f "$f" ]; then echo "keys: you already have an age identity ($f); its public key:" >&2
  else ( umask 077; age-keygen -o "$f" ) 2>/dev/null && chmod 600 "$f" || { rm -f "$f"; echo "keys: age-keygen failed" >&2; exit 1; }; fi
  [ "$(file_low9 "$f")" = 600 ] && [ "$(file_owner "$f")" = "$(id -u)" ] || { echo "keys: $f must be a 0600 file of yours: chmod 600 $f" >&2; exit 1; }
  pub="$(age-keygen -y "$f")" || { echo "keys: cannot read $f" >&2; exit 1; }
  printf '%s\n' "$pub"
  echo "keys: send this age1… key to the sender (bin/keys share <that key> …); bin/keys receive opens blocks with $f" >&2
}
receive() {
  local file="" anyhub=0 new=0 block armor e rc why f i l r n v bhub="" bfrom="" bto="" btime="" bexp="" ended=0 ex tm now stored="" kept="" failed=""
  local ver bsigner="" endi=0 sfp="" want="" anyto=0 notme=0 age
  local ids=() L=() names=() vals=() plain
  local link="" base lh id resp code
  while [ $# -gt 0 ]; do case "$1" in
      --new) new=1 ;;
      --any-hub) anyhub=1 ;;
      --any-to) anyto=1 ;;
      --from) gh_user_ok "${2:-}" || { echo "keys: --from takes a GitHub user name" >&2; exit 2; }; want="$2"; shift ;;
      -i) [ -n "${2:-}" ] || bad; [ -f "$2" ] || { echo "keys: no identity file at $2" >&2; exit 1; }; ids+=(-i "$2"); shift ;;
      -*) bad ;;
      *) [ -z "$file" ] || bad; file="$1" ;;
    esac; shift; done
  if [ "$new" = 1 ]; then [ -z "$file" ] && [ "${#ids[@]}" = 0 ] && [ "$anyhub" = 0 ] && [ "$anyto" = 0 ] && [ -z "$want" ] || bad; new_identity; return; fi
  # a link (story I6): https://<HUB_ONETIME_URL's host>/secret/<id> and nothing else, checked before any request
  case "$file" in *://*) link="$file"; file=""; base="$(onetime_base)" || exit 2
    [[ "$link" =~ [[:space:][:cntrl:]] ]] && refuse "the link holds whitespace or a control character"
    [[ "$link" =~ ^https://([^/]+)/secret/([A-Za-z0-9]{20,128})/?$ ]] && lh="${BASH_REMATCH[1]}" && id="${BASH_REMATCH[2]}" &&
      [ "$(printf '%s' "$lh" | tr 'A-Z' 'a-z')" = "$(printf '%s' "${base#https://}" | tr 'A-Z' 'a-z')" ] ||
      refuse "not a one-time link on ${base#https://} (HUB_ONETIME_URL): $base/secret/<id> only" ;; esac
  need_age; keychain
  # the default identities; ~/.ssh/id_rsa only beside its id_rsa.pub (age needs the public half for an encrypted one)
  if [ "${#ids[@]}" = 0 ]; then for f in "$HOME/.ssh/id_ed25519" "$HOME/.ssh/id_rsa" "$(age_dir)/key.txt"; do
      [ -f "$f" ] || continue; [ "$f" != "$HOME/.ssh/id_rsa" ] || [ -f "$f.pub" ] || continue; ids+=(-i "$f"); done; fi
  [ "${#ids[@]}" -gt 0 ] || { echo "keys: no identity to open it: ~/.ssh/id_ed25519, ~/.ssh/id_rsa, -i <identity>, or bin/keys receive --new" >&2; exit 1; }
  FROM_FILE=0
  # the link is fetched only now that there is an identity to open it with: a fetch uses it up
  if [ -n "$link" ]; then
    resp="$(printf '{"continue":true}' | onetime_post "$base" "/api/v3/guest/secret/$id/reveal")" || refuse "could not fetch the link"
    code="${resp##*$'\n'}"; resp="${resp%$'\n'*}"; [[ "$code" =~ ^[0-9]{3}$ ]] || code=000
    case "$code" in
      200) block="$(printf '%s' "$resp" | python3 -I -c 'import json, sys; v = json.load(sys.stdin)["record"]["secret_value"]
assert isinstance(v, str) and v; print(v)' 2>/dev/null)" ||
             refuse "${base#https://} sent no block" ;;
      404) refuse "the link was already opened or expired (a one-time link opens once); ask the sender for a new one" ;;
      000) refuse "could not fetch the link: ${base#https://} did not answer (timeout or network)" ;;
      *) refuse "could not fetch the link: ${base#https://} answered HTTP $(shown "$code")" ;;
    esac; unset resp; FROM_FILE=1
    echo "keys: fetched the block; the link is used up now (a one-time link opens once)" >&2
  elif [ -n "$file" ]; then [ -f "$file" ] || { echo "keys: no such file: $file" >&2; exit 1; }; block="$(cat -- "$file")"; FROM_FILE=1
  else [ ! -t 0 ] || echo "keys: paste the block, then Ctrl-D" >&2; block="$(cat)"; fi
  # the armor alone (a block pasted with chat text around it still opens)
  armor="$(printf '%s\n' "$block" | tr -d '\r' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | sed -n '/^-----BEGIN AGE ENCRYPTED FILE-----$/,/^-----END AGE ENCRYPTED FILE-----$/p')"
  case "$armor" in *"-----END AGE ENCRYPTED FILE-----") ;; *) refuse "this is not a sealed block (-----BEGIN AGE ENCRYPTED FILE----- … END)" ;; esac
  [ -z "$link" ] || KEEP=1
  e="$(mktemp "${TMPDIR:-/tmp}/ade-keys.XXXXXX")" || exit 1
  # a NUL byte (which a shell variable would drop silently) becomes \001, and is refused below
  plain="$(set -o pipefail; printf '%s\n' "$armor" | age -d "${ids[@]}" 2>"$e" | LC_ALL=C tr '\000' '\001')"; rc=$?
  if [ "$rc" != 0 ]; then
    if grep -qi "no identity matched" "$e"; then why="not sealed to your keys (tried:$(for ((i = 1; i < ${#ids[@]}; i += 2)); do printf ' %s' "${ids[$i]}"; done); if it was sealed to another key of yours: -i <identity>"
    else why="age could not open it: $(head -1 "$e" | sed 's/^age: //; s/^error: //')"; fi
    rm -f "$e"; refuse "$why"
  fi
  rm -f "$e"
  # what is shown is what was signed: share never writes a NUL or an empty line, and the line split below drops both
  case "$plain" in *$'\001'*) refuse "the block holds a NUL byte (not made by bin/keys share)" ;; esac
  case "$plain" in "ade-keys-share 2"$'\n'*) case "$plain" in *$'\n\n'*) refuse "the signed block holds an empty line (not made by bin/keys share)" ;; esac ;; esac
  local IFS=$'\n'; set -f; L=($plain); set +f; unset IFS; unset plain
  # v1: unsigned (story I4); v2: signed, with a signer: line and the signature after "end" (story I5)
  case "${L[0]:-}" in "ade-keys-share 1") ver=1 ;; "ade-keys-share 2") ver=2 ;; *) refuse "not an ade keys block (or one from a newer version)" ;; esac
  for ((i = 1; i < ${#L[@]}; i++)); do l="${L[$i]}"
    case "$l" in
      "hub: "*) bhub="${l#hub: }" ;; "from: "*) bfrom="${l#from: }" ;; "to: "*) bto="${l#to: }" ;;
      "time: "*) btime="${l#time: }" ;; "expires: "*) bexp="${l#expires: }" ;;
      "signer: "*) [ "$ver" = 2 ] || refuse "line $((i + 1)) is not part of the format"; bsigner="${l#signer: }" ;;
      "secret "*) r="${l#secret }"; n="${r%% *}"; v="${r#* }"
        [ "$n" != "$r" ] && [ -n "$v" ] && secret_name_ok "$n" || refuse "entry $((${#names[@]} + 1)) is malformed"
        names+=("$n"); vals+=("$v") ;;
      end) ended=1; endi=$i; break ;;
      *) refuse "line $((i + 1)) is not part of the format" ;;
    esac
  done
  [ "$ended" = 1 ] || refuse "the block is incomplete (no end)"
  [ "${#names[@]}" -gt 0 ] || refuse "the block holds no key"
  ex="$(utc_epoch "${bexp%Z}")"; [ -n "$ex" ] || refuse "the block has no readable expiry"
  tm="$(utc_epoch "${btime%Z}")"; [ -n "$tm" ] || refuse "the block has no readable time"
  now="$(keys_now)"
  [ "$tm" -le $((now + 300)) ] || refuse "the block was sealed in the future ($(shown "$btime"))"
  [ "$ex" -ge "$tm" ] || refuse "the block expires before it was sealed"
  [ $((ex - tm)) -le $((30 * 86400)) ] || refuse "the block expires more than 30 days after it was sealed"
  [ "$now" -lt "$ex" ] || refuse "the block expired at $(shown "$bexp"); ask $(shown "$bfrom") for a new one"
  [ "$bhub" = "$(hub_name)" ] || [ "$anyhub" = 1 ] || refuse "the block is for hub $(shown "$bhub"), not this one ($(hub_name)); --any-hub takes it anyway"
  # the sender (story I5): a v2 block must carry a good signature by its signer; --from names the only signer taken
  if [ "$ver" = 2 ]; then gh_user_ok "$bsigner" || refuse "the block names no readable signer"; fi
  if [ -n "$want" ] && { [ "$ver" != 2 ] || [ "$(printf '%s' "$bsigner" | tr 'A-Z' 'a-z')" != "$(printf '%s' "$want" | tr 'A-Z' 'a-z')" ]; }; then
    if [ "$ver" = 2 ]; then refuse "the block is signed by $bsigner, not $want (--from $want)"; else refuse "the block is not signed, and --from $want takes only a block signed by $want"; fi; fi
  [ "$ver" != 2 ] || verify_block
  # the receiver (story I5): a signed to: must be you, or a block sent to someone else could be forwarded to you
  if [ "$ver" = 2 ] && ! to_is_me "$bto"; then
    [ "$anyto" = 1 ] || refuse "the block was sealed to $(shown "$bto"), not you (forwarded?); --any-to takes it anyway"; notme=1; fi
  age=$(( (now - tm) / 86400 )); [ "$age" -ge 0 ] || age=0
  # what it holds, then one yes before anything is stored: anyone with your public key can seal a block
  { echo "keys: the block holds ${#names[@]} key(s):"
    echo "  hub:     $(shown "$bhub")"
    if [ -n "$sfp" ]; then echo "  from:    $bsigner (verified: signed by $sfp)"
    else echo "  from:    $(shown "$bfrom") (not verified: check with them that they sent it)"; fi
    echo "  to:      $(shown "$bto")"
    [ "$notme" = 0 ] || echo "  warning: sent to $(shown "$bto"), not you (--any-to)"
    echo "  sealed:  $(shown "$btime") (sealed $age day(s) ago), expires $(shown "$bexp")"
    for ((i = 0; i < ${#names[@]}; i++)); do if secret_has "${names[$i]}"; then echo "  ${names[$i]}: replace"; else echo "  ${names[$i]}: new"; fi; done
    printf 'keys: store these? [y/N] '; } >&2
  ask || { unset L vals; echo "keys: nothing stored" >&2; keep_block; exit 1; }
  for ((i = 0; i < ${#names[@]}; i++)); do n="${names[$i]}"
    if secret_has "$n"; then printf 'keys: %s is already stored; replace it? [y/N] ' "$n" >&2
      ask || { kept="$kept $n"; continue; }; fi
    if secret_put "$n" "${vals[$i]}"; then stored="$stored $n"; else failed="$failed $n"; fi
  done
  unset L vals
  echo "keys: stored:${stored:- none}" >&2
  [ -z "$kept" ] || echo "keys: kept your own:$kept" >&2
  [ -z "$failed" ] || { echo "keys: could not store in $(secret_store_label):$failed" >&2; exit 1; }
}
case "${1:-}" in
  "") [ $# -eq 0 ] || bad; keychain
    for t in $(key_tools); do
      s="$(key_secret "$t")"; why="$(tool_state "$t")"
      if "$H/bin/secret" --has "$s"; then st=stored; else st=missing; fi
      printf '%-10s %-8s %s\n' "$t" "$st" "$s"
      [ "$st" = stored ] || echo "  set it: bin/keys set $t (key from $(key_source "$t"))"
      if [ "$t" = anthropic ] && [ "$st" != stored ]; then echo "  optional: without it, bin/agent uses your Claude login"; continue; fi
      if [ -n "$why" ]; then echo "  not usable yet: $why"; elif [ "$st" = stored ]; then [ "$t" = telegram ] && echo "  ready for bin/chat" || echo "  ready for bin/agent"; fi
    done ;;
  set) [ $# -eq 2 ] || bad; s="$(tool_name "$2")" || exit 2; keychain
    [ "$2" != anthropic ] || echo "keys: the Anthropic key is used by bin/agent --live-test; role runs use it only with HUB_AGENT_ANTHROPIC_KEY=1 in hub.conf (else the Claude login)" >&2
    # exec, so a signal reaches the store itself; bin/secret reads the value (never this script) and prints the note only
    # once the key is stored and read back. A failed, refused or cancelled store says nothing of the kind (story K1)
    exec "$H/bin/secret" --set "$s" --note "keys: $2 stored in $(secret_store_label); agents never see it. Share it sealed: bin/keys share <github-user> $2" ;;
  forget) [ $# -eq 2 ] || bad; s="$(tool_name "$2")" || exit 2; keychain
    "$H/bin/secret" --has "$s" || { echo "keys: no key stored for $2" >&2; exit 1; }
    exec "$H/bin/secret" --forget "$s" ;;
  share) shift; share "$@" ;;
  receive) shift; receive "$@" ;;
  *) bad ;;
esac
