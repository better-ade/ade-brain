#!/bin/bash
# bin/changes [folder]: UserPromptSubmit hook in EVERY session (hub root and each folder's settings; no model).
# Since this session's last prompt: other folders' STATE.md updates and new journal entries (text, trimmed), hub-root
# journal entries (folder sessions only), and new or updated memory files (hub memory/ and each folder's memory/, with
# their description). The session's own folder is not echoed back. One snapshot per session (hook stdin session_id);
# the first prompt only records a baseline. Output capped. Then this session's unread events from the hub's event log
# (story C6, bin/events.py), each line marked as data, not instructions. Always exits 0.
. "$(dirname "$0")/lib.sh"; H="$(hub_root)"; ST="$(state_dir)"; mkdir -p "$ST"
[ -z "${1:-}" ] || session_mark "$1" busy   # a focus session shows as busy in bin/sessions from its prompt on
# the script goes in -c so stdin stays the hook JSON (read in Python with a deadline: bash 3.2's read -t drops partial input)
PY_SRC=$(cat <<'PY'
import glob, json, os, re, select, time
H, ST, OWN = (os.environ[k] for k in ("H", "ST", "OWN"))
raw = b""
if not os.isatty(0):
    end = time.time() + 2
    while time.time() < end:
        r, _, _ = select.select([0], [], [], max(0, end - time.time()))
        if not r: break
        b = os.read(0, 65536)
        if not b: break
        raw += b
        if b'"session_id"' in raw and raw.rstrip().endswith(b"}"): break
m = re.search(rb'"session_id"\s*:\s*"([A-Za-z0-9_-]+)"', raw)
SID = m.group(1).decode() if m else ""
if SID and os.environ.get("SIDF"):
    try: open(os.environ["SIDF"], "w").write(SID)
    except OSError: pass
OWN = OWN.rstrip("/")
ROOT = OWN in ("", ".")
snap = os.path.join(ST, "changes-seen." + SID if SID else "changes-seen")
# per-session snapshots older than 7 days are left-overs of ended sessions
for p in glob.glob(os.path.join(ST, "changes-seen.*")):
    if p == snap or p.endswith(".new"): continue   # never this session's own snapshot
    try:
        if time.time() - os.path.getmtime(p) > 7 * 86400: os.remove(p)
    except OSError: pass

def trim(s, n=200):
    s = " ".join(s.split()); return s if len(s) <= n else s[: n - 1] + "…"

# journal entries per folder, oldest first: "## HH:MM UTC · <folder>" then the text lines
entries = {}
for j in sorted(glob.glob(os.path.join(H, "journal", "[0-9]*.md"))):
    cur = None
    for line in open(j, encoding="utf-8", errors="replace"):
        m = re.match(r"^## .* · (.+)$", line.rstrip("\n"))
        if m:
            cur = m.group(1).strip(); cur = "." if cur == "hub" else cur
            if "/" not in cur and cur != ".":   # short labels ("app") name the folder too
                for top in ("projects", "ops"):
                    if os.path.isfile(os.path.join(H, top, cur, "STATE.md")): cur = top + "/" + cur; break
            entries.setdefault(cur, []).append([]); continue
        if cur is not None and line.strip(): entries[cur][-1].append(line.strip())

folders = {}
for d in sorted(glob.glob(os.path.join(H, "projects", "*")) + glob.glob(os.path.join(H, "ops", "*"))):
    s = os.path.join(d, "STATE.md")
    if not os.path.isfile(s): continue
    f = os.path.relpath(d, H)
    folders[f] = [int(os.path.getmtime(s)), len(entries.get(f, []))]
folders["."] = [0, len(entries.get(".", []))]

mem = {}
for p in glob.glob(os.path.join(H, "memory", "*.md")) + glob.glob(os.path.join(H, "projects", "*", "memory", "*.md")) \
        + glob.glob(os.path.join(H, "ops", "*", "memory", "*.md")):
    if os.path.basename(p) == "MEMORY.md": continue
    try: mem[os.path.relpath(p, H)] = int(os.path.getmtime(p))
    except OSError: pass

try: prev = json.load(open(snap))
except Exception: prev = None
tmp = snap + ".new"
json.dump({"folders": folders, "mem": mem}, open(tmp, "w")); os.replace(tmp, snap)
# this session's unread events (story C6); a broken log never stops the rest
ev = []
try:
    import importlib.util
    spec = importlib.util.spec_from_file_location("events", os.environ["EV"]); E = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(E); ev = E.deliver(E.sid_of({"session_id": SID}), OWN, False)
except Exception: ev = []
if prev is None:
    if ev: print("\n".join(ev))
    raise SystemExit(0)

out = []
pf, pm = prev.get("folders", {}), prev.get("mem", {})
for f, (m, n) in folders.items():
    if f == "." and ROOT: continue           # the root session's own notes
    if f == OWN: continue                    # a folder session's own STATE and journal
    om, on = pf.get(f, [m, n])
    bits = []
    if f != "." and m != om: bits.append("STATE.md updated " + time.strftime("%H:%M", time.localtime(m)))
    new = n - on
    if new > 0: bits.append("%d journal line%s" % (new, "s" if new > 1 else ""))
    if not bits: continue
    out.append("%s: %s" % ("hub" if f == "." else f, ", ".join(bits)))
    if new > 0:
        last = entries.get(f, [])[-new:]
        for e in last[-3:]: out.append("  - " + trim(" ".join(e)))
        if new > 3: out.append("  - (+%d more in journal/)" % (new - 3))
for p, m in sorted(mem.items()):
    if pm.get(p) == m: continue
    desc = ""
    try:   # only the front matter's description (block scalars joined), never the body
        lines = open(os.path.join(H, p), encoding="utf-8", errors="replace").read().split("\n")[:40]
        if lines and lines[0].strip() == "---":
            for i, line in enumerate(lines[1:], 1):
                if line.strip() == "---": break
                if line.startswith("description:"):
                    v = line.split(":", 1)[1].strip()
                    if v[:1] in (">", "|"):
                        parts = []
                        for nxt in lines[i + 1:]:
                            if nxt.strip() == "---" or (nxt and not nxt[0].isspace()): break
                            parts.append(nxt.strip())
                        v = " ".join(x for x in parts if x)
                    desc = trim(v.strip("'\""), 160); break
    except OSError: pass
    out.append("memory: %s %s%s" % ("new" if p not in pm else "updated", p, ": " + desc if desc else ""))
CAP = 40
if len(out) > CAP: out = out[:CAP] + ["... (%d more lines: see journal/ and memory/)" % (len(out) - CAP)]
out += ev
if out: print("\n".join(out))
PY
)
R=""; [ -z "${1:-}" ] || R="$(repos_of "$1" 2>/dev/null)"
SIDF=""; [ -z "${1:-}" ] || SIDF="$ST/.sid.$$"
H="$H" ST="$ST" OWN="${1:-}" EV="$(dirname "$0")/events.py" REPOS="$R" SIDF="$SIDF" python3 -I -c "$PY_SRC" 2>/dev/null
# the Claude session id goes in the focus session's entry (bin/recover: --resume <id>, story R1)
if [ -n "$SIDF" ] && [ -s "$SIDF" ]; then session_mark "$1" busy "$(cat "$SIDF")"; fi; [ -z "$SIDF" ] || rm -f "$SIDF"
exit 0
