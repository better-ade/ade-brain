#!/bin/bash
# bin/learn: what a person tells their agents about how to work, kept per person, confirmed by them, and loaded at every
# session start (story L1; contract .ade/context/learn.md). Files: memory/users/<user>/{profile.md,feedback/<slug>.md,
# MEMORY.md,log.md}; <user> is hub_user (bin/lib.sh). No model is ever called.
#   bin/learn feedback [--scope hub|<folder>|role:<role>] --rule "<line>" --words "<their words>" --why "<line>" --apply "<line>"
#       one file per rule; the same rule again (same scope, equal after normalising) raises its `repeated` instead.
#       Scope default: this session's folder (AGENT_FOLDER, else the hub folder the command runs in), else hub. Inside a
#       folder, another folder's scope is refused and role:<role> means that role in this folder only.
#   bin/learn profile "<fact>"            one dated line in profile.md
#       Every capture waits: it loads only once the person confirms it.
#   bin/learn confirm [<slug>|profile]    the person, at their own terminal (never an agent session): each waiting entry
#       in full, yes / no (deleted, "rejected <slug>" logged) / later. Confirmations live in $(state_dir)/learn/.
#   bin/learn list | show <slug|profile>  the person's own entries
#   bin/learn edit <slug|profile>         $EDITOR on a copy, the person's terminal only; saved only when it passes the
#       same checks, then it waits for confirmation again
#   bin/learn forget <slug>               the slug typed back at the person's terminal; logs "forgot <slug>"
#   bin/learn context [folder]            the session-start block (bin/context prints it): confirmed profile facts and
#       rules for this folder and role (AGENT_ROLE), most repeated first, at most HUB_LEARN_LINES lines (default 30), and
#       how many wait for confirmation; the hub root: hub only
#   bin/learn pending [--quoted]          the waiting entries, one line each (--quoted: JSON strings, at most 10; bin/briefing)
#   bin/learn recent [--quoted | --mark <UTC time>]  log lines since the last briefing's mark (bin/briefing)
# A value is refused (exit 1, one line naming the reason, never the value) when gitleaks finds a secret in it (or gitleaks
# is missing), it holds an email address, a phone or national id number, a control, bidi or zero-width character, or
# (rule, why, apply, fact) markup, a link, a # line or wording that grants an approval or switches off asking.
# Exit: 0 done, 1 refused / not found / not confirmed, 2 usage.
. "$(dirname "$0")/lib.sh"; H="$(hub_root)"
USAGE="usage: bin/learn feedback [--scope S] --rule R --words W --why Y --apply A | profile <fact> | confirm [slug] | list | show <slug> | edit <slug> | forget <slug> | context [folder] | pending | recent"
# this session's folder: AGENT_FOLDER (bin/work, bin/agent), else the hub folder the command runs in
here="${AGENT_FOLDER:-}"
if [ -z "$here" ]; then case "$PWD/" in "$H"/projects/?*/*|"$H"/ops/?*/*) here="$(printf '%s' "${PWD#"$H"/}" | cut -d/ -f1-2)" ;; esac; fi
learn_py() { LEARN_HUB="$H" LEARN_USER="$(hub_user)" LEARN_HERE="$here" LEARN_ROLE="${AGENT_ROLE:-}" LEARN_FOLDERS="$(folders)" \
  LEARN_STATE="$(state_dir)" LEARN_LINES="${HUB_LEARN_LINES:-30}" LEARN_SESSION_VARS="$(agent_session_vars)" \
  python3 -I "$(dirname "$0")/learn.py" "$@"; }
tty_ok() { [ -t 0 ] && [ -t 1 ] && { : </dev/tty; } 2>/dev/null; }
# the person's own commands: an interactive terminal, and no agent session around it
person() { if in_agent_session; then echo "learn: refused: $1 is the person's own, at their own terminal, never from an agent session" >&2; exit 1; fi
  tty_ok || { echo "learn: refused: $1 needs the person at an interactive terminal; nothing changed" >&2; exit 1; }; }
case "${1:-}" in
  feedback|profile|list|show|context|pending|recent) learn_py "$@"; exit $? ;;
  confirm) person confirm; learn_py "$@"; exit $? ;;
  edit)
    [ $# -eq 2 ] || { echo "$USAGE" >&2; exit 2; }
    f="$(learn_py path "$2")" || exit $?
    person edit
    ed="${VISUAL:-${EDITOR:-vi}}"; T="$(mktemp -d)"; trap 'rm -rf "$T"' EXIT; cp "$f" "$T/$2.md" || exit 1
    # shellcheck disable=SC2086
    $ed "$T/$2.md" </dev/tty >/dev/tty || { echo "learn: the editor failed; nothing changed" >&2; exit 1; }
    learn_py apply "$2" "$T/$2.md"; exit $? ;;
  forget)
    [ $# -eq 2 ] || { echo "$USAGE" >&2; exit 2; }
    learn_py path "$2" >/dev/null || exit $?
    [ "$2" != profile ] || { echo "learn: the profile is not forgotten whole; bin/learn edit profile" >&2; exit 2; }
    person forget
    printf 'Forget %s? Type the slug to confirm: ' "$2" >/dev/tty
    typed=""; read -r -t 120 typed </dev/tty || true
    [ "$typed" = "$2" ] || { echo "learn: not confirmed; nothing forgotten" >&2; exit 1; }
    learn_py forget "$2"; exit $? ;;
  *) echo "$USAGE" >&2; exit 2 ;;
esac
