#!/bin/bash
# bin/new <projects|ops>/<name> [--repo <checkout> | --repo owner/name[=<checkout>]]...: a folder from templates/, plus
# its named agent. Never overwrites. On a folder that exists it keeps every file and only adds what is missing.
# --repo (story P1, .ade/context/access-code-rows.md): one row in the folder's ACCESS.md Code table, read from the
# checkout (bin/lib.sh repo_row: owner/name from origin, else (no remote) with no origin; origin/HEAD's branch; GitHub
# Actions CI). The checkout is never written. Refused (exit 2, nothing written): a repo already in that Code table (a
# (no remote) row by its checkout), a checkout that is not a directory. A new owner/name joins HUB_REPOS in hub.conf (bin/doctor checks it); commit hub.conf after.
# bin/new --settings <folder>: re-renders only that existing folder's .claude/settings.json and .mcp.json from the
# templates (hooks and permissions added since the folder was made, story C6; the browser override, story V3), after
# copying each old file to <file>.bak (gitignored).
# .mcp.json: the folder's `playwright` MCP server, <hub>/bin/browser run <folder> (its browser profile and output folder).
# Both name the hub as "$CLAUDE_PROJECT_DIR"/../.. (story I1, .ade/context/per-machine.md), so they hold on any path; the
# one machine path, the hub's CLAUDE.md in claudeMdExcludes, goes to the gitignored .claude/settings.local.json
# (bin/lib.sh folder_local_write; bin/setup writes it on a clone).
set -u; . "$(dirname "$0")/lib.sh"; H="$(hub_root)"; F="${1:-}"; SETTINGS=0; REPOS=()
usage() { echo "usage: bin/new projects/<name>|ops/<name> (a-z 0-9 -) [--repo <checkout>|owner/name[=<checkout>]]... | bin/new --settings <folder>" >&2; exit 2; }
[ $# = 0 ] || shift
if [ "$F" = --settings ]; then SETTINGS=1; F="${1:-}"; [ $# = 0 ] || shift; fi
while [ $# -gt 0 ]; do [ "$1" = --repo ] && [ "$SETTINGS" = 0 ] && [ -n "${2:-}" ] || usage; REPOS+=("$2"); shift 2; done
[[ "$F" =~ ^(projects|ops)/[a-z0-9-]+$ ]] || usage
[ "$F" != ops/access ] || { echo "new: ops/access is the access registry (bin/ssh), not a folder" >&2; exit 2; }
[ "$SETTINGS" = 0 ] || [ -d "$H/$F" ] || { echo "new: no folder $F" >&2; exit 2; }
NAME="${F#*/}"; AGENT="$(agent_name "$F")"
# --repo rows, every one checked before anything is written
A="$H/$F/ACCESS.md"; ROWS=""; NEW_REPOS=""; SEEN=$'\n'
# in_code <repo> <checkout>: the repo is in the Code table (a row of ## Code, or any table row whose checkout starts
# with / or ~); a (no remote) row matches only by its checkout (~ expanded)
in_code() { [ -f "$A" ] && R="$1" K="$2" awk -F'|' '/^## /{c=($0 ~ /^## Code/)} /^\|/ {x=$2; k=$3; gsub(/^[ \t]+|[ \t]+$/, "", x)
  gsub(/^[ \t]+|[ \t]+$/, "", k); if (!c && k !~ /^[\/~]/) next
  if (k == "~" || substr(k, 1, 2) == "~/") k = ENVIRON["HOME"] substr(k, 2)
  if (x == ENVIRON["R"] && (x != "(no remote)" || k == ENVIRON["K"])) f=1} END {exit !f}' "$A"; }
for r in ${REPOS[@]+"${REPOS[@]}"}; do
  [[ "$r" != *=* ]] || [[ "${r%%=*}" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]] || { echo "new: --repo must be <checkout> or owner/name[=<checkout>]" >&2; exit 2; }
  repo_row "$r" "$(hub_owner)"
  [ -z "$ROW_CHECKOUT" ] || [ -d "$ROW_CHECKOUT" ] || { echo "new: checkout $ROW_CHECKOUT is not a directory" >&2; exit 2; }
  case "$ROW_REPO$ROW_CHECKOUT" in *"|"*|*$'\n'*) echo "new: a repo or checkout with | or a newline cannot go in the Code table" >&2; exit 2 ;; esac
  K="$ROW_REPO"; [ "$ROW_REPO" != "(no remote)" ] || K="$ROW_REPO $ROW_CHECKOUT"
  case "$SEEN" in *$'\n'"$K"$'\n'*) echo "new: $K is given twice" >&2; exit 2 ;; esac; SEEN="$SEEN$K"$'\n'
  ! in_code "$ROW_REPO" "$ROW_CHECKOUT" || { echo "new: $K is already in $F/ACCESS.md" >&2; exit 2; }
  ROWS="$ROWS$ROW"$'\n'
  [[ "$ROW_REPO" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]] || continue
  case " ${HUB_REPOS:-}$NEW_REPOS " in *" $ROW_REPO "*) ;; *) NEW_REPOS="$NEW_REPOS $ROW_REPO" ;; esac
done
put() {  # template destination
  local dst="$H/$2"; if [ -e "$dst" ]; then echo "kept $2"; return; fi
  mkdir -p "$(dirname "$dst")"
  # python, not sed: an owner, title or hub path with & or # would be read as sed syntax
  P_FOLDER="$F" P_NAME="$NAME" P_AGENT="$AGENT" P_HUB="$H" P_TITLE="$(persona_title)" P_AGENT_MODEL="${HUB_AGENT_MODEL:-sonnet}" \
  P_HUBNAME="$(hub_name)" P_OWNER="$(hub_owner)" python3 - "$H/templates/$1" "$dst" <<'PY' || exit 1
import os, sys
s = open(sys.argv[1]).read()
for k in ("FOLDER", "NAME", "AGENT", "HUB", "TITLE", "AGENT_MODEL", "HUBNAME", "OWNER"):
    s = s.replace("{{%s}}" % k, os.environ["P_" + k])
open(sys.argv[2], "w").write(s)
PY
  echo "made $2"
}
if [ "$SETTINGS" = 1 ]; then
  for S in "$H/$F/.claude/settings.json" "$H/$F/.mcp.json"; do
    if [ -f "$S" ]; then cp -p "$S" "$S.bak" || { echo "new: could not copy $S to $S.bak" >&2; exit 1; }; rm -f "$S"; fi; done
  put folder-settings.json "$F/.claude/settings.json"; put folder-mcp.json "$F/.mcp.json"
  folder_local_write "$F" >/dev/null || exit 1; exit 0
fi
put CLAUDE.md "$F/CLAUDE.md"; put ACCESS.md "$F/ACCESS.md"; put STATE.md "$F/STATE.md"
put MEMORY.md "$F/memory/MEMORY.md"; put folder-settings.json "$F/.claude/settings.json"; put folder-mcp.json "$F/.mcp.json"
# this machine's part (the hub's CLAUDE.md excluded): gitignored, written for this hub's path (story I1)
folder_local_write "$F" >/dev/null || exit 1
put agent.md ".claude/agents/$AGENT.md"
if [ -n "$ROWS" ]; then
  # the rows go at the end of the Code table (after its last | line), every other line as it was
  ROWS="$ROWS" awk 'c && t && !/^\|/ {printf "%s", ENVIRON["ROWS"]; c = t = 0; ok = 1}
    /^## Code/ && !d {c = d = 1} c && /^\|---/ {t = 1} {print}
    END {if (t) {printf "%s", ENVIRON["ROWS"]; ok = 1}; exit !ok}' "$A" > "$A.tmp" && mv "$A.tmp" "$A" ||
    { rm -f "$A.tmp"; echo "new: no Code table in $F/ACCESS.md to add the repos to" >&2; exit 1; }
  printf '%s' "$ROWS" | while IFS='|' read -r _ repo co _; do repo="${repo# }"; repo="${repo% }"
    [ "$repo" != "(no remote)" ] || repo="$repo ${co# }"; echo "added ${repo% } to $F/ACCESS.md"; done
fi
if [ -n "$NEW_REPOS" ] && [ -f "$H/hub.conf" ]; then
  L="HUB_REPOS=$(printf '%q' "$(echo ${HUB_REPOS:-}$NEW_REPOS)")"
  L="$L" awk '/^HUB_REPOS=/ {if (!d) print ENVIRON["L"]; d = 1; next} {print} END {if (!d) print ENVIRON["L"]}' "$H/hub.conf" > "$H/hub.conf.tmp" &&
    mv "$H/hub.conf.tmp" "$H/hub.conf" || { rm -f "$H/hub.conf.tmp"; echo "new: could not write HUB_REPOS in hub.conf" >&2; exit 1; }
  echo "added$NEW_REPOS to HUB_REPOS in hub.conf: commit hub.conf (bin/sync leaves it out)"
fi
focus_hub_sync "$F" >/dev/null   # the hub's rules as copies inside the folder (.ade/context/focus-folders.md)
[ -x "$H/bin/setup" ] && "$H/bin/setup" >/dev/null
exit 0
