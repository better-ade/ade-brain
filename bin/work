#!/bin/bash
# bin/work [--role R | --provider P --model M] [--claude CMD] [--model M] [--effort E] [--prompt TEXT] [--mode M] [--name N] [--no-remote] [--force] [--agent-model [name=]M] [--agent-effort [name=]E] <folder> [repo]: deep work in a new Terminal, inside the project's checkout, with the folder's hooks.
# A folder with no repo (none, or a "(none ...)" row) works in the hub folder itself. Clones a missing checkout (owner/name as given, else HUB_CODE_OWNER/<name>) to ${AGENT_CODE_DIR:-$HOME/Project}/<name> and records the path in ACCESS.md.
# --claude picks the Claude install (default: claude_cmd in lib.sh); a bare name runs what the caller's PATH finds, and the
# session keeps the caller's CLAUDE_CONFIG_DIR (or none), so it runs as the same install and account. --model / --effort (anywhere in the arguments) pass through to claude for this session.
# --prompt TEXT is the session's first message (passed last, after --, quoted for the launcher).
# --mode M is the permission mode (default HUB_WORK_MODE from hub.conf, else auto, the main session's usual mode): a focus
# session in the main session's mode takes its messages without holding them for approval in its own terminal, so the
# main session is the one place to say go. --mode manual asks in the focus terminal. bypassPermissions is never allowed.
# Remote Control is on for every session, named after the folder (projects/acme -> acme); --name N names it N instead
# (two sessions on one folder); --no-remote turns it off.
# A folder whose session is already running with Remote Control (a claude process with --remote-control <name>) is refused
# with exit 3 (the name checked is --name N when given) before anything is opened or changed; --force opens another anyway.
# --provider P (default HUB_PROVIDER from hub.conf, else anthropic) runs Claude Code against another provider's endpoint (story SP,
# .ade/context/providers.md): only providers in hub.conf's HUB_PROVIDERS_ALLOWED; plain claude; no Remote Control, no resume;
# its own config dir; a merged settings file whose apiKeyHelper reads the key (the key is checked once, never written).
# --role R (story C2) picks the provider and model with role_pick (bin/lib.sh; .ade/context/providers.md, "Roles"), then
# takes the --provider/--model path with all its gates; it excludes --model and --provider (exit 2). No usable candidate:
# exit 1 with each skip reason, nothing opened. The role is recorded for bin/sessions.
# A gemini pick (--role, or --provider gemini --model gemini-*; story E1, .ade/context/engines.md "Gemini CLI engine") runs
# the Gemini CLI through bin/gemini-run instead of Claude Code: its own checks (allowlist, owner-only unless
# HUB_GEMINI_CLIENT_APPROVED=1, the CLI installed, a sign-in or a stored key, the checkout's own .gemini configuration),
# never yolo (any spelling: exit 2); bin/gemini-run checks them again and gives the CLI the hub's settings and policy,
# no Claude Code flag (--effort, --agent-*, --claude: exit 2), --mode as the CLI's approval mode (auto and acceptEdits =
# auto_edit, manual = default, plan = plan), --prompt as its first message (-i), no Remote Control, no --agents.
# --agent-model / --agent-effort (repeatable) set the folder's specialist agents: a bare value sets all, name=value one (it wins). WORK_DRY=1 only prints the command. AGENT_TERMINAL=iterm uses iTerm.
# Inside an ADE terminal (ADE_HOOK_BIN executable; ADE_HOOK_PORT, ADE_HOOK_TOKEN, ADE_PTY_ID set) the session opens as a
# sub-terminal of the caller's tab and NEVER in a Terminal or iTerm window (owner, 2026-11-09; stories W1 and W1b):
# - an ADE whose `help` lists "capabilities: command": "$ADE_HOOK_BIN" open --cwd <checkout> --name <folder> --focus -- bash -l <launcher>;
#   its exit 5 prints the command to run there;
# - an ADE with `ade open` but no typed command (v0.23.0, the stopgap): the same open with no command, then one line with
#   the command to paste into the new sub-terminal; the launcher is kept;
# - any other `ade open` answer, or an ADE without `ade open`: fails with ADE's message, nothing opened, no window.
# AGENT_TERMINAL=terminal|iterm is a window outside ADE and exit 2 inside it; AGENT_TERMINAL=ade is exit 2 outside ADE.
set -u; . "$(dirname "$0")/lib.sh"; H="$(hub_root)"
# temp files (merged settings, launcher) go on any exit until the launcher is handed off; the launcher then removes them
MS=""; L=""; trap '[ -z "$MS" ] || rm -f "$MS"; [ -z "$L" ] || rm -f "$L"' EXIT
USAGE="usage: bin/work [--role R] [--provider P] [--claude CMD] [--model M] [--effort low|medium|high|xhigh|max] [--prompt TEXT] [--mode auto|manual|acceptEdits|plan] [--name N] [--no-remote] [--force] [--agent-model [name=]M] [--agent-effort [name=]E] <projects|ops>/<name> [repo]  (AGENT_TERMINAL=terminal|iterm|ade)"
MODEL=""; EFFORT=""; PROMPT=""; MODE=""; REMOTE=1; RNAME=""; FORCE=0; CL="$(claude_cmd)"; POS=(); ASET=""; PROV="${HUB_PROVIDER:-anthropic}"; ROLE=""; PSET=0
while [ $# -gt 0 ]; do
  case "$1" in
    --model|--effort|--claude|--provider|--mode|--role) [ $# -ge 2 ] || { echo "$USAGE" >&2; exit 2; }
      case "$1" in --mode) MODE="$2" ;; --model) MODEL="$2" ;; --effort) EFFORT="$2" ;; --provider) PROV="$2"; PSET=1 ;; --role) ROLE="$2" ;; *) CL="$2" ;; esac; shift 2 ;;
    --no-remote) REMOTE=0; shift ;;
    --force) FORCE=1; shift ;;
    --name) [ $# -ge 2 ] && [[ "$2" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || { echo "work: --name needs a name of A-Za-z0-9._- only, starting with a letter or digit" >&2; exit 2; }
      RNAME="$2"; shift 2 ;;
    --prompt) [ $# -ge 2 ] && [ -n "$2" ] || { echo "$USAGE" >&2; exit 2; }; PROMPT="$2"; shift 2 ;;
    --agent-model|--agent-effort) [ $# -ge 2 ] || { echo "$USAGE" >&2; exit 2; }
      k="${1#--agent-}"; v="${2#*=}"; n=""; [ "$v" = "$2" ] || n="${2%%=*}"
      [[ "$n" =~ ^[A-Za-z0-9._-]*$ ]] || { echo "work: bad agent name '$n'" >&2; exit 2; }
      if [ "$k" = model ]; then [[ "$v" =~ ^[A-Za-z0-9._:/-]+$ ]] || { echo "work: bad agent model '$v'" >&2; exit 2; }
      else case "$v" in low|medium|high|xhigh|max) ;; *) echo "work: agent effort must be low|medium|high|xhigh|max" >&2; exit 2 ;; esac; fi
      ASET="$ASET$k $n $v"$'\n'; shift 2 ;;
    *) POS+=("$1"); shift ;;
  esac
done
[[ "$CL" =~ ^[A-Za-z0-9._/-]+$ ]] || { echo "work: bad claude command '$CL'" >&2; exit 2; }
# --role: one way to choose; the pick becomes --provider and --model, so every check below applies to it
if [ -n "$ROLE" ]; then
  [ -z "$MODEL" ] && [ "$PSET" = 0 ] || { echo "work: --role picks the provider and model; drop --model and --provider" >&2; exit 2; }
  # role_pick's candidate_refusal (delegation), judged for this session: a focus go and plain claude on this install ($CL)
  cs="$(role_candidates "$ROLE")" || exit 2   # unknown role or bad table: role_candidates said why
  ROLE_PICK=""; ROLE_SKIPS=""
  for c in $cs; do
    why="$(AGENT_CLAUDE="$CL" candidate_refusal "$c")"; p="${c%%:*}"
    [ -n "$why" ] || [ "$p" = anthropic ] || provider_feature_go "$p" focus || why="$(provider_no_go_reason "$p" focus)"
    [ -n "$why" ] || { ROLE_PICK="$c"; break; }
    ROLE_SKIPS="${ROLE_SKIPS}skipped $c: $why"$'\n'
  done
  [ -n "$ROLE_PICK" ] || { echo "work: no usable model for role $ROLE" >&2; printf '%s' "$ROLE_SKIPS" | sed 's/^/  /' >&2; exit 1; }
  PROV="${ROLE_PICK%%:*}"; MODEL="${ROLE_PICK#*:}"
  # an earlier candidate skipped is said, so nothing moves to another engine or vendor unnoticed
  [ -z "$ROLE_SKIPS" ] || printf '%s' "$ROLE_SKIPS" | sed 's/^/work: /' >&2
fi
# an Anthropic model may carry the 1M-context suffix, opus[1m] (role tables allow it); it is quoted for the launcher
MRE='^[A-Za-z0-9._:/-]+$'; [ "$PROV" != anthropic ] || MRE='^[A-Za-z0-9._:/-]+(\[1m\])?$'
[ -z "$MODEL" ] || [[ "$MODEL" =~ $MRE ]] || { echo "work: bad model name '$MODEL'" >&2; exit 2; }
case "$EFFORT" in ""|low|medium|high|xhigh|max) ;; *) echo "work: effort must be low|medium|high|xhigh|max" >&2; exit 2 ;; esac
# subagents that name no model: an inherited CLAUDE_CODE_SUBAGENT_MODEL (ADE sets models) wins, else hub.conf, else sonnet.
# Set in the launcher, never in settings (a settings env would replace ADE's). An explicit Agent or agent-file model still wins.
SUBM="${CLAUDE_CODE_SUBAGENT_MODEL:-${HUB_SUBAGENT_MODEL:-sonnet}}"
# names may carry a context suffix such as sonnet[1m]; nothing that could end the launcher's double quotes ($ ` " \)
SUBRE='^[][A-Za-z0-9._:/-]+$'
[ "$PROV" != anthropic ] || [[ "$SUBM" =~ $SUBRE ]] || { echo "work: bad subagent model '$SUBM' (CLAUDE_CODE_SUBAGENT_MODEL or HUB_SUBAGENT_MODEL)" >&2; exit 2; }
# token limits (.ade/context/model-defaults.md): the context window the session compacts at, and its inline Bash output
# cap. Exported by the launcher unless the session inherits a value (ADE's wins); 0 leaves Claude's default.
CWIN="${HUB_COMPACT_WINDOW:-200000}"; BMAX="${HUB_BASH_MAX_CHARS:-8000}"
[[ "$CWIN" =~ ^[0-9]+$ ]] || { echo "work: bad HUB_COMPACT_WINDOW '$CWIN' (tokens; 0 = Claude's default)" >&2; exit 2; }
[[ "$BMAX" =~ ^[0-9]+$ ]] || { echo "work: bad HUB_BASH_MAX_CHARS '$BMAX' (characters; 0 = Claude's default)" >&2; exit 2; }
# hub.conf defaults (HUB_MODEL, HUB_EFFORT, HUB_AGENT_MODEL); the command line wins
# (a provider session never takes HUB_MODEL, which may be a full Anthropic id)
[ -n "$MODEL" ] || [ "$PROV" != anthropic ] || MODEL="${HUB_MODEL:-}"; [ -n "$EFFORT" ] || EFFORT="${HUB_EFFORT:-}"
[ -n "$MODE" ] || MODE="${HUB_WORK_MODE:-auto}"
case "$MODE" in auto|manual|acceptEdits|plan) ;; *) echo "work: mode must be auto|manual|acceptEdits|plan" >&2; exit 2 ;; esac
[ -z "$MODEL" ] || [[ "$MODEL" =~ $MRE ]] || { echo "work: bad model name '$MODEL'" >&2; exit 2; }
case "$EFFORT" in ""|low|medium|high|xhigh|max) ;; *) echo "work: effort must be low|medium|high|xhigh|max" >&2; exit 2 ;; esac
# the provider: allowed in hub.conf, permitted for this hub, plain claude, a go for each feature used, no resume, its own models
[[ "$PROV" =~ ^[a-z0-9-]+$ ]] || { echo "work: bad provider name '$PROV'" >&2; exit 2; }
case " ${HUB_PROVIDERS_ALLOWED:-anthropic} " in *" $PROV "*) ;; *) echo "work: provider $PROV is not in HUB_PROVIDERS_ALLOWED (hub.conf)" >&2; exit 2 ;; esac
if [ "$PROV" = gemini ]; then
  why="$(provider_own_hub_refusal)"; [ -z "$why" ] || { echo "work: $why" >&2; exit 2; }
  why="$(provider_hub_refusal gemini)"; [ -z "$why" ] || { echo "work: $why" >&2; exit 2; }
  provider_feature_go gemini focus || { echo "work: $(provider_no_go_reason gemini focus)" >&2; exit 2; }
  why="$(gemini_system_refusal)"; [ -z "$why" ] || { echo "work: $why" >&2; exit 2; }
  command -v "$(gemini_cmd)" >/dev/null 2>&1 || { echo "work: the Gemini CLI ($(gemini_cmd)) is not installed" >&2; exit 1; }
  [ -n "$MODEL" ] && gemini_model_ok "$MODEL" || { echo "work: the Gemini CLI needs a Gemini model (--model gemini-*), not '${MODEL:-none}'" >&2; exit 2; }
  why="$(gemini_yolo_refusal ${POS[@]+"${POS[@]}"})"; [ -z "$why" ] || { echo "work: $why" >&2; exit 2; }
  [ -z "$EFFORT" ] && [ -z "$ASET" ] && [ "$CL" = "$(claude_cmd)" ] || { echo "work: --effort, --agent-model, --agent-effort and --claude are Claude Code flags; the Gemini CLI takes none of them" >&2; exit 2; }
  for a in ${POS[@]+"${POS[@]}"}; do case "$a" in -*) echo "work: $a is not passed to the Gemini CLI; bin/work takes only its own flags" >&2; exit 2 ;; esac; done
  case "$MODE" in manual) GMODE=default ;; plan) GMODE=plan ;; *) GMODE=auto_edit ;; esac
  REMOTE=0
elif [ "$PROV" != anthropic ]; then
  why="$(provider_own_hub_refusal)"; [ -z "$why" ] || { echo "work: $why" >&2; exit 2; }
  provider_field "$PROV" base_url >/dev/null || { echo "work: no provider '$PROV' in bin/lib.sh" >&2; exit 2; }
  why="$(provider_hub_refusal "$PROV")"; [ -z "$why" ] || { echo "work: $why" >&2; exit 2; }
  [ "$CL" = claude ] || { echo "work: --provider $PROV needs plain claude, not '$CL' (a wrapper could send the session elsewhere)" >&2; exit 2; }
  provider_feature_go "$PROV" focus || { echo "work: $(provider_no_go_reason "$PROV" focus)" >&2; exit 2; }
  if [ -n "$EFFORT" ] || [[ "$ASET" == *"effort "* ]]; then provider_feature_go "$PROV" effort || { echo "work: $(provider_no_go_reason "$PROV" effort)" >&2; exit 2; }; fi
  for a in ${POS[@]+"${POS[@]}"}; do case "$a" in --resume|--resume=*|--continue|-r|-c)
    echo "work: a provider session does not resume history ($a would send it to $PROV); start a new session (--resume leak, .ade/context/engines.md)" >&2; exit 2 ;; esac; done
  PMODELS="$(provider_models "$PROV")"
  [ -z "$MODEL" ] || provider_model_ok "$PROV" "$MODEL" || { echo "work: --model $MODEL is not a $PROV model ($PMODELS)" >&2; exit 2; }
  PM="$(provider_model_var "$PROV")"; PS="$(provider_small_var "$PROV")"
  why="$(provider_conf_models_refusal "$PROV")"; [ -z "$why" ] || { echo "work: $why" >&2; exit 2; }
  P_MAIN="$(provider_model_id "$PROV" "${!PM:-$(provider_field "$PROV" model)}")"; P_SMALL="$(provider_model_id "$PROV" "${!PS:-$(provider_field "$PROV" small)}")"
  REMOTE=0
fi
F="${POS[0]:-}"; F="${F%/}"; WANT="${POS[1]:-}"   # projects/x/ (tab completion) = projects/x
[ -n "$F" ] && [ -d "$H/$F" ] && [ -f "$H/$F/ACCESS.md" ] || { echo "$USAGE" >&2; exit 2; }
# one session per folder: refuse when a claude process already runs with --remote-control <name> (whole word; a grep or
# editor that mentions it is not a session; the program must be claude*, as an exec'ing wrapper leaves it; a session
# started with --no-remote has no name and is not seen). Full command lines (-ww): plain `ps aux` cuts long ones (a folder with many
# agents) short. ps runs to completion before the filter starts, so the filter never sees itself. Read-only, so dry runs check too.
if [ "$REMOTE" = 1 ] && [ "$FORCE" = 0 ]; then
  procs="$(ps -axww -o pid=,command= 2>/dev/null)"
  pid=$(awk -v n="${RNAME:-${F##*/}}" 'p=="" {b=$2; sub(/.*\//,"",b); if(b ~ /^claude/) for(i=3;i<NF;i++) if($i=="--remote-control" && $(i+1)==n) p=$1} END{print p}' <<<"$procs")
  [ -z "$pid" ] || { echo "work: ${RNAME:-${F##*/}} is already running (pid $pid); use it, or stop it first (--force opens another)" >&2; exit 3; }
fi
# where the session opens: a sub-terminal in ADE (all four ADE variables set) or a Terminal/iTerm window; decided once
# the arguments and the folder are checked, so a typo fails without probing ADE
in_ade() { [ -n "${ADE_HOOK_BIN:-}" ] && [ -f "$ADE_HOOK_BIN" ] && [ -x "$ADE_HOOK_BIN" ] && [ -n "${ADE_HOOK_PORT:-}" ] &&
  [ -n "${ADE_HOOK_TOKEN:-}" ] && [ -n "${ADE_PTY_ID:-}" ]; }
# what this ADE can do, from its `help` (stdout only; stdin from /dev/null, since hook mode reads stdin to its end; at most
# 5 s; the exit status is ignored): "command" = it types a command into the new sub-terminal (story 9: a line starting
# "capabilities:" with the word "command"); "bare" = it has `ade open` but cannot type (stories 4a/4c, v0.23.0: a line
# starting "usage: ade open"); "none" = no `ade open` (a hook-mode build answers {} and 0 to anything, so its open would
# silently do nothing) or no answer
ade_level() { local h; h="$(timeout 5 "$ADE_HOOK_BIN" help </dev/null 2>/dev/null)"
  if printf '%s\n' "$h" | grep -Eq '^capabilities:.*[[:space:]]command([[:space:]]|$)'; then echo command
  elif printf '%s\n' "$h" | grep -q '^usage: ade open'; then echo bare; else echo none; fi; }
NOWIN="inside ADE bin/work never opens a window; for one, run bin/work $F from a terminal outside ADE"
OPEN=window
if in_ade; then
  # inside ADE every session opens in ADE, never in a Terminal or iTerm window (owner, 2026-11-09; story W1b)
  case "${AGENT_TERMINAL:-}" in terminal|iterm)
    echo "work: AGENT_TERMINAL=$AGENT_TERMINAL: inside ADE every session opens in ADE; run bin/work from a terminal outside ADE for a window" >&2; exit 2 ;; esac
  OPEN=dry
  if [ "${WORK_DRY:-}" != 1 ]; then OPEN="$(ade_level)"   # a dry run never calls the helper
    [ "$OPEN" != none ] || { echo "work: this ADE cannot open a sub-terminal ('$ADE_HOOK_BIN help' shows no ade open, or did not answer in 5 s); update or restart ADE; $NOWIN" >&2; exit 1; }
  fi
elif [ "${AGENT_TERMINAL:-}" = ade ]; then
  echo "work: AGENT_TERMINAL=ade needs an ADE terminal (ADE_HOOK_BIN, ADE_HOOK_PORT, ADE_HOOK_TOKEN and ADE_PTY_ID set)" >&2; exit 2
fi
A="$H/$F/ACCESS.md"
# Code table rows (or rows appended later with an absolute checkout) as "<repo>|<checkout>" (first = default)
rows=$(awk -F'|' '/^## /{c=($0=="## Code")} /^\|/{n=$2; k=$3; gsub(/^[ \t]+|[ \t]+$/,"",n); gsub(/^[ \t]+|[ \t]+$/,"",k);
  if((c || k ~ /^[\/~]/) && n!="" && n!="Repo" && n !~ /^-+$/ && n !~ /^\(/) print n "|" k}' "$A")   # "(none ...)" = no repo
if [ -z "$rows" ]; then
  # a folder with no code repo of its own works in the hub folder itself
  [ -z "$WANT" ] || { echo "work: no repo '$WANT' in $F/ACCESS.md" >&2; exit 2; }
  dir="$H/$F"
else
  # a repo may be named owner/name in ACCESS.md; WANT matches the full name or the name alone
  row=$(echo "$rows" | { if [ -n "$WANT" ]; then awk -F'|' -v w="$WANT" '{n=$1; sub(/.*\//,"",n)} $1==w || n==w {print; exit}'; else head -1; fi; })
  [ -n "$row" ] || { echo "work: no repo '$WANT' in $F/ACCESS.md" >&2; exit 2; }
  repo="${row%%|*}"; name="${repo##*/}"; dir="${row#*|}"; dir="${dir/#\~/$HOME}"
  own=$(grep -F "| $repo |" "$A" | grep -o 'checkout owned by [^ |]*' | head -1)
  if [ -z "${dir// /}" ] && [ -n "$own" ]; then echo "work: $repo: $own; run bin/work ${own#checkout owned by }" >&2; exit 2; fi
  if [ ! -d "$dir" ]; then
    dir="${AGENT_CODE_DIR:-$HOME/Project}/$name"; slug="$repo"; if [ "$slug" = "$name" ]; then [ -n "$(code_owner)" ] || { echo "work: $repo has no owner (write owner/name in ACCESS.md or set HUB_CODE_OWNER)" >&2; exit 2; }; slug="$(code_owner)/$name"; fi
    if [ ! -d "$dir" ]; then
      mkdir -p "$(dirname "$dir")"; gh repo clone "$slug" "$dir" >&2 || { echo "work: clone of $repo failed" >&2; exit 2; }
    fi
    # record the checkout path in this repo's row (BSD-safe: rewrite via a temp file)
    awk -F'|' -v OFS='|' -v r="$repo" -v d="$dir" '/^## /{c=($0=="## Code")} /^\|/{n=$2; gsub(/^[ \t]+|[ \t]+$/,"",n); if((c || $3 ~ /\/|~/) && n==r){$3=" " d " "}} {print}' "$A" > "$A.tmp" && mv "$A.tmp" "$A"
  fi
fi
# the folder's specialist agents (front matter + body) go to the session as --agents JSON
agents=""
if [ "$PROV" = gemini ]; then
  ! ls "$H/$F/.claude/agents/"*.md >/dev/null 2>&1 || echo "work: the Gemini CLI has no --agents; $F's specialist agents are not loaded in this session" >&2
elif ls "$H/$F/.claude/agents/"*.md >/dev/null 2>&1; then
  # the hub's agent model goes first, so any --agent-model on the command line overrides it
  # (not in a provider session: HUB_AGENT_MODEL may be a full Anthropic id)
  [ "$PROV" = anthropic ] && [ -n "${HUB_AGENT_MODEL:-}" ] && [[ "$HUB_AGENT_MODEL" =~ ^[A-Za-z0-9._:/-]+$ ]] && ASET="model  $HUB_AGENT_MODEL"$'\n'"$ASET"
  agents=$(WORK_ASET="$ASET" WORK_PROVIDER="$PROV" WORK_MODELS="${PMODELS:-}" python3 - "$H/$F/.claude/agents/"*.md <<'PY'
import json, sys, os
out = {}
prov = os.environ.get("WORK_PROVIDER", "anthropic")
for p in sys.argv[1:]:
    t = open(p).read()
    if not t.startswith("---\n"): continue
    head, _, body = t[4:].partition("\n---\n")
    fm = {}
    for l in head.splitlines():
        if ":" in l and not l.startswith((" ", "-")):
            k, _, v = l.partition(":"); fm[k.strip()] = v.strip()
    name = fm.get("name") or os.path.basename(p)[:-3]
    # one provider per Claude process: an agent naming another provider is left out (delegation is bin/agent's)
    if (fm.get("provider") or prov) != prov:
        print("work: delegatable (not in --agents): %s (provider %s)" % (name, fm["provider"]), file=sys.stderr); continue
    a = {"description": fm.get("description", ""), "prompt": body.strip()}
    if fm.get("tools"): a["tools"] = [x.strip() for x in fm["tools"].split(",")]
    if fm.get("model") and fm["model"] != "inherit": a["model"] = fm["model"]
    out[name] = a
# per-task overrides: "<model|effort> <name or empty> <value>"; bare values first, so name= wins
sets = [l.split(" ") for l in os.environ.get("WORK_ASET", "").splitlines() if l]
for k, n, v in sorted(sets, key=lambda s: s[1] != ""):
    if n and n not in out: sys.exit("work: no agent '%s' in this folder" % n)
    for name in ([n] if n else out): out[name][k] = v
models = os.environ.get("WORK_MODELS", "").split()
for name, a in out.items():
    if models and "model" in a and a["model"] not in models:
        sys.exit("work: agent %s model %s is not a %s model (%s)" % (name, a["model"], prov, " ".join(models)))
print(json.dumps(out, separators=(",", ":")))
PY
) || exit 2
elif [ -n "$ASET" ]; then echo "work: $F has no specialist agents for --agent-model/--agent-effort" >&2; exit 2
fi
[ "$PROV" = anthropic ] || [ -z "$agents" ] || provider_feature_go "$PROV" agents || { echo "work: $(provider_no_go_reason "$PROV" agents)" >&2; exit 2; }
sq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }   # single-quoted for the launcher, a ' inside kept
TRAP='rm -f "$0"'
if [ "$PROV" = gemini ]; then
  why="$(gemini_checkout_refusal "$dir")"; [ -z "$why" ] || { echo "work: $why" >&2; exit 2; }
  # fail closed, before anything is written: the CLI's own Google login, else a stored key (read once, never kept)
  GA="read"; [ "${WORK_DRY:-}" != 1 ] || GA="has"
  GAUTH="$(gemini_auth "$GA")" || { echo "work: $(gemini_auth_hint)" >&2; exit 1; }
  echo "work: Gemini CLI signed in with $([ "$GAUTH" = google ] && echo "its Google login" || echo "the stored gemini-api-key")" >&2
  cmd="cd $(sq "$dir") && AGENT_FOLDER='$F' $(sq "$H/bin/gemini-run") --auth $GAUTH --mode focus -m $(printf %q "$MODEL") --approval-mode $GMODE"
  [ -z "$PROMPT" ] || cmd="$cmd -i $(printf %q "$PROMPT")"
elif [ "$PROV" = anthropic ]; then
  # the caller's install: a bare name runs what the caller's PATH finds, since a new window's login shell may find another
  # claude first (an explicit path, or a name not on PATH, is kept as given)
  case "$CL" in */*) ;; *) p="$(command -v -- "$CL" 2>/dev/null)"; [[ "$p" == /* && "$p" =~ ^[A-Za-z0-9._/-]+$ ]] && CL="$p" ;; esac
  cmd="cd $(sq "$dir") && AGENT_FOLDER='$F' $CL --settings $(sq "$H/$F/.claude/settings.json")"
else
  SEC="$(provider_field "$PROV" secret)"; CD="$H/.local/providers/$PROV"; SCRUB="$(provider_scrub_vars)"
  why="$(provider_config_refusal "$PROV")"; [ -z "$why" ] || { echo "work: $why" >&2; exit 2; }
  why="$(provider_checkout_refusal "$PROV" "$dir")"; [ -z "$why" ] || { echo "work: $why" >&2; exit 2; }
  # fail closed: Claude Code never starts against another provider without its key (it would send the Anthropic login there)
  if [ "${WORK_DRY:-}" != 1 ]; then
    provider_key_ok "$PROV" || { echo "work: no $(provider_field "$PROV" label) in the Keychain; store it with: bin/secret --set $SEC" >&2; exit 1; }
  fi
  # one settings file: the folder's (hooks kept) plus the provider layer (provider_settings_write)
  [ -f "$H/$F/.claude/settings.json" ] || { echo "work: $F has no .claude/settings.json" >&2; exit 2; }
  MS=$(mktemp "${TMPDIR:-/tmp}/agent-settings.XXXXXX") && chmod 600 "$MS" || exit 2
  provider_settings_write "$H/$F/.claude/settings.json" "$MS" "$PROV" "$P_MAIN" "$P_SMALL" || exit 2
  # its own config dir, so /model writes there and not to the owner's settings.json; env -u drops any credential or backend
  # switch the launching (login) shell holds, since those beat apiKeyHelper
  cmd="cd $(sq "$dir") && env$(printf ' -u %s' $SCRUB) AGENT_FOLDER='$F' CLAUDE_CONFIG_DIR=$(sq "$CD") $CL --settings $(sq "$MS")"
  TRAP="rm -f \"\$0\" $(sq "$MS")"
fi
if [ "$PROV" != gemini ]; then   # Claude Code's flags; the gemini command is complete above
  [ -n "$agents" ] && cmd="$cmd --agents $(printf %q "$agents")"
  cmd="$cmd --permission-mode $MODE"
  [ -n "$MODEL" ] && cmd="$cmd --model $(printf %q "$MODEL")"
  [ -n "$EFFORT" ] && cmd="$cmd --effort $EFFORT"
  [ "$REMOTE" = 1 ] && cmd="$cmd --remote-control $(printf %q "${RNAME:-${F##*/}}")"
  [ -n "$PROMPT" ] && cmd="$cmd -- $(printf %q "$PROMPT")"
fi
echo "$cmd"
# a dry run shows the merged settings instead of keeping the file (the EXIT trap removes it)
if [ "${WORK_DRY:-}" = 1 ]; then
  if [ "$OPEN" != window ]; then
    echo "work: if this ADE lists capabilities: command, this runs: $ADE_HOOK_BIN open --cwd $dir --name ${F##*/} --focus -- bash -l <launcher>" >&2
    echo "work: if it does not, this runs: $ADE_HOOK_BIN open --cwd $dir --name ${F##*/} --focus (no command) and prints the command to paste there: bash -l <launcher>" >&2
  fi
  [ -z "$MS" ] || { cat "$MS"; echo; } 2>/dev/null; exit 0
fi
if [ "$PROV" != anthropic ] && [ "$PROV" != gemini ]; then   # the memory links bin/setup makes, inside the provider's config dir
  plink() { local m="$CD/projects/$(encode_path "$1")/memory"; mkdir -p "$2" "$(dirname "$m")"
    [ -L "$m" ] && [ "$(readlink "$m")" = "$2" ] && return 0
    if [ -d "$m" ] && [ ! -L "$m" ]; then mv "$m" "$m.bak-$(date -u +%Y%m%dT%H%M%SZ)"; fi
    rm -f "$m"; ln -s "$2" "$m"; }
  plink "$H" "$H/memory"; plink "$dir" "$H/$F/memory"
fi
# a session on another Claude account than the hub's (HUB_CLAUDE_CONFIG_DIR) gets the hub's memory links there, as
# bin/setup makes them, so what it remembers reaches the hub. Its account: the dir its wrapper exports, else the caller's
# CLAUDE_CONFIG_DIR, else ~/.claude. Never with CLAUDE_HOME set (tests) or WORK_NO_OPEN; a dry run has exited above.
if [ "$PROV" = anthropic ] && [ -z "${CLAUDE_HOME:-}" ] && [ "${WORK_NO_OPEN:-}" != 1 ]; then
  SCD="$(wrapper_config_dir "$CL")"; SCD="${SCD:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}}"; HCD="$(claude_home)"
  if [ "${SCD%/}" != "${HCD%/}" ]; then
    if link_memory "$SCD" "$H" >/dev/null && link_memory "$SCD" "$dir" "$H/$F/memory" >/dev/null; then
      echo "work: this session runs as $SCD, not the hub's $HCD; linked the hub's memory there" >&2
    else echo "work: this session runs as $SCD, not the hub's $HCD, and the hub's memory could not be linked there" >&2; fi
  fi
fi
# the command (it may hold quotes from the agents JSON) runs from a launcher script, so no AppleScript escaping is needed
# the launcher registers the session in $(state_dir)/sessions/<name>.<launcher pid> (name = --name N, else the folder name) while it runs (bin/sessions lists them);
# parent = the Claude session that ran bin/work ($CLAUDE_PID), so an orchestrator can list its own children
SD="$(state_dir)/sessions"
reg=$(printf 'R=%q.$$\nmkdir -p %q && printf '"'"'name=%%s\\nfolder=%%s\\nlauncher=%%s\\nparent=%%s\\nstarted=%%s\\ncwd=%%s\\nrole=%%s\\nengine=%%s\\n'"'"' %q %q "$$" %q "$(date -u +%%Y-%%m-%%dT%%H:%%M:%%SZ)" %q %q %q > "$R"' \
  "$SD/${RNAME:-${F##*/}}" "$SD" "${RNAME:-${F##*/}}" "$F" "${CLAUDE_PID:--}" "$dir" "${ROLE:--}" "$(engine_of "$PROV")")
# an Anthropic session's subagent default ($SUBM, checked above) is exported by the launcher, so a value its own shell has
# still wins; a provider session never sets it (.ade/context/providers.md)
sub=""; [ "$PROV" = anthropic ] && sub="export CLAUDE_CODE_SUBAGENT_MODEL=\"\${CLAUDE_CODE_SUBAGENT_MODEL:-$SUBM}\""$'\n'
# ...and the caller's account: its CLAUDE_CONFIG_DIR, or none (unset, so a login shell's value cannot switch accounts).
# A wrapper that exports its own still wins. A provider session sets its own dir.
if [ "$PROV" = anthropic ]; then
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then sub="${sub}export CLAUDE_CONFIG_DIR=$(sq "$CLAUDE_CONFIG_DIR")"$'\n'; else sub="${sub}unset CLAUDE_CONFIG_DIR"$'\n'; fi
fi
# the token limits (checked above), for every provider behind Claude Code
[ "$PROV" = gemini ] && CWIN=0 BMAX=0
[ "$CWIN" = 0 ] || sub="${sub}export CLAUDE_CODE_AUTO_COMPACT_WINDOW=\"\${CLAUDE_CODE_AUTO_COMPACT_WINDOW:-$CWIN}\""$'\n'
[ "$BMAX" = 0 ] || sub="${sub}export BASH_MAX_OUTPUT_LENGTH=\"\${BASH_MAX_OUTPUT_LENGTH:-$BMAX}\""$'\n'
# a terminal can carry the session variables of a Claude session that has exited (ADE hands them to every sub-terminal):
# with them the new session starts as a child of that dead session and no other session can list or message it
SESS_UNSET='unset CLAUDE_PID CLAUDE_CODE_CHILD_SESSION CLAUDE_CODE_MESSAGING_SOCKET CLAUDE_CODE_MESSAGING_TOKEN CLAUDE_CODE_SESSION_ID CLAUDE_CODE_BRIDGE_SESSION_ID CLAUDE_CODE_SESSION_ATTENDED CLAUDE_CODE_ENTRYPOINT CLAUDECODE'
L=$(mktemp "${TMPDIR:-/tmp}/agent-work.XXXXXX"); printf '#!/bin/bash\ntrap %s EXIT\n%s\n%s\n%s%s\n' "$(sq "$TRAP \"\$R\"")" "$reg" "$SESS_UNSET" "$sub" "$cmd" > "$L"; chmod +x "$L"
# WORK_NO_OPEN=1 (tests): write the launcher, print its path, open nothing (both files are kept for the caller)
[ "${WORK_NO_OPEN:-}" = 1 ] && { echo "launcher: $L"; MS=""; L=""; exit 0; }
if [ "$OPEN" != window ]; then
  # inside ADE: never a window (W1b). Only the launcher's path goes to ADE (with "command"; "bare" sends no command); its
  # stdout is dropped, the first line of its stderr is the reason
  if [ "$OPEN" = command ]; then why=$("$ADE_HOOK_BIN" open --cwd "$dir" --name "${F##*/}" --focus -- bash -l "$L" 2>&1 >/dev/null); rc=$?
  else why=$("$ADE_HOOK_BIN" open --cwd "$dir" --name "${F##*/}" --focus 2>&1 >/dev/null); rc=$?; fi
  why="${why%%$'\n'*}"; why="${why:-no message}"
  case "$OPEN:$rc" in
    command:0) MS=""; L=""; exit 0 ;;   # typed into the new sub-terminal: its shell runs the launcher, which removes both
    command:5) echo "work: ADE opened the sub-terminal but did not type the command ($why); run it there: bash -l $(printf %q "$L")" >&2
      MS=""; L=""; exit 5 ;;            # handed to the user: kept for that run, no second session
    bare:0) echo "work: opened sub-terminal '${F##*/}' in ADE; paste this there to start the session: bash -l $(sq "$L")" >&2
      MS=""; L=""; exit 0 ;;            # the stopgap: handed to the user, kept for that run
    *) # 1 refused, 2 usage, 3 and 4 unreachable, 5 without a command, anything else: nothing kept, no window
      echo "work: ade open failed (exit $rc): $why; nothing was opened; $NOWIN" >&2; exit "$rc" ;;
  esac
fi
if [ "${AGENT_TERMINAL:-terminal}" = iterm ]; then
  osascript -e "tell application \"iTerm\" to create window with default profile command \"bash -l $L\""
else
  osascript -e "tell application \"Terminal\" to do script \"bash -l $L\"" -e 'tell application "Terminal" to activate'
fi && { MS=""; L=""; }   # handed off: the launcher's own trap removes both
