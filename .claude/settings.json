{
  "autoCompactWindow": 200000,
  "bashOutputMaxChars": 8000,
  "permissions": {
    "ask": [
      "Bash(*bin/dispatch --approve*)",
      "Bash(*ade dispatch --approve*)",
      "Bash(*bin/agent --live-test*)",
      "Bash(script *)",
      "Bash(*bin/chat send*)",
      "Bash(*ade chat send*)",
      "Bash(*ade shot screen*)",
      "Bash(*ade shot*--tg*)",
      "Bash(*bin/chat answer*)",
      "Bash(*ade chat answer*)",
      "Bash(*bin/chat to *)",
      "Bash(*ade chat to *)",
      "Edit(**/channels/*/access.json)",
      "Write(**/channels/*/access.json)",
      "Edit(//**/channels/*/access.json)",
      "Write(//**/channels/*/access.json)",
      "Edit(~/.agent-hub/**/access.json)",
      "Write(~/.agent-hub/**/access.json)",
      "Bash(*access.json*)",
      "Bash(*channels/telegram*)",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_type",
      "mcp__playwright__browser_fill_form",
      "mcp__playwright__browser_file_upload",
      "mcp__playwright__browser_press_key",
      "mcp__playwright__browser_select_option",
      "mcp__playwright__browser_evaluate",
      "mcp__plugin_browser_playwright__browser_click",
      "mcp__plugin_browser_playwright__browser_type",
      "mcp__plugin_browser_playwright__browser_fill_form",
      "mcp__plugin_browser_playwright__browser_file_upload",
      "mcp__plugin_browser_playwright__browser_press_key",
      "mcp__plugin_browser_playwright__browser_select_option",
      "mcp__plugin_browser_playwright__browser_evaluate",
      "Bash(*bin/browser login*)",
      "Bash(*bin/browser forget*)",
      "Bash(*ade browser*)",
      "Edit(/hub.conf)",
      "Bash(*hub.conf*)",
      "Bash(*bin/learn feedback*)",
      "Bash(*bin/learn profile*)",
      "Bash(*bin/learn forget*)",
      "Bash(*bin/learn confirm*)",
      "Bash(*learn.py*)",
      "Edit(/memory/users/**)",
      "Write(/memory/users/**)"
    ],
    "deny": [
      "Read(~/.config/ade/browser/**)",
      "Edit(~/.config/ade/browser/**)"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/journal hub \"(compaction at the hub root: update the folders' STATE.md for anything in progress)\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/changes"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/inbox"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/stop-check"
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "bmad-code-review": "name-only",
    "bmad-prd": "name-only",
    "bmad-ux": "name-only",
    "bmad-deep-recon": "name-only",
    "bmad-retrospective": "name-only",
    "bmad-correct-course": "name-only",
    "bmad-brainstorming": "name-only",
    "bmad-forge-idea": "name-only",
    "bmad-qa-generate-e2e-tests": "name-only",
    "bmad-walkthrough": "name-only",
    "bmad-toolsmith": "name-only",
    "bmad-eval": "name-only",
    "bmad-project-context": "name-only",
    "bmad-build-auto": "name-only",
    "bmad-advanced-elicitation": "name-only",
    "bmad-prfaq": "name-only",
    "bmad-product-brief": "name-only",
    "bmad-agent-analyst": "off",
    "bmad-agent-architect": "off",
    "bmad-agent-dev": "off",
    "bmad-agent-pm": "off",
    "bmad-agent-ux-designer": "off",
    "bmad-party-mode": "off",
    "bmod-core-tools": "off",
    "bmod-method": "off",
    "bmod-toolsmith": "off"
  },
  "autoCompactEnabled": true
}
